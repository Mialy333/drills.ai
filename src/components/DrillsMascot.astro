---
type Mood = "welcome" | "thinking" | "encouragement" | "success" | "help" | "recommendation" | "difficulty";

interface Props {
  mood?: Mood;
  size?: number;
  label?: string;
}

const { mood = "welcome", size = 48, label } = Astro.props;
---

<svg
  class="drills-mascot"
  data-mascot
  data-mood={mood}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <defs>
    <linearGradient id="mascot-shell" x1="16" y1="10" x2="49" y2="55" gradientUnits="userSpaceOnUse">
      <stop stop-color="#faf9f6" />
      <stop offset="1" stop-color="#f59ad7" />
    </linearGradient>
  </defs>
  <path d="M18 57h28l-4 3H22z" fill="#101010" opacity=".16" />
  <path d="M32 10V6h-3" fill="none" stroke="#101010" stroke-width="2" />
  <rect x="29" y="2" width="6" height="6" fill="#c8f900" stroke="#101010" stroke-width="1.5" />
  <path d="M22 12h20l5 5v30l-5 7H22l-5-7V17z" fill="url(#mascot-shell)" stroke="#101010" stroke-width="2" shape-rendering="crispEdges" />
  <rect x="12" y="27" width="6" height="14" fill="#5987cf" stroke="#101010" stroke-width="1.5" />
  <rect x="46" y="27" width="6" height="14" fill="#5987cf" stroke="#101010" stroke-width="1.5" />
  <rect x="21" y="20" width="22" height="22" fill="#171917" stroke="#101010" stroke-width="2" />
  <g class="mascot-face mascot-face-welcome">
    <rect x="26" y="27" width="4" height="5" fill="#c8f900" /><rect x="35" y="27" width="4" height="5" fill="#c8f900" />
    <path d="M27 35h3v2h4v-2h3" fill="none" stroke="#c8f900" stroke-width="2" />
  </g>
  <g class="mascot-face mascot-face-thinking">
    <rect x="26" y="27" width="4" height="5" fill="#f1bd45" /><rect x="35" y="27" width="4" height="5" fill="#f1bd45" />
    <path d="M29 37h6" stroke="#f1bd45" stroke-width="2" />
    <rect x="48" y="9" width="9" height="9" fill="#faf9f6" stroke="#101010" /><rect x="51" y="11" width="3" height="3" fill="#f1bd45" />
  </g>
  <g class="mascot-face mascot-face-encouragement">
    <path d="M25 29h4m6 0h4" stroke="#c8f900" stroke-width="2" />
    <path d="M27 34h3v3h4v-3h3" fill="none" stroke="#c8f900" stroke-width="2" />
    <path d="M52 9v8m-4-4h8" stroke="#f1bd45" stroke-width="2" />
  </g>
  <g class="mascot-face mascot-face-success">
    <path d="M25 29h2v-2h2m6 2h2v-2h2" fill="none" stroke="#c8f900" stroke-width="2" />
    <path d="M27 34h3v3h4v-3h3" fill="none" stroke="#c8f900" stroke-width="2" />
    <path d="M52 9v8m-4-4h8" stroke="#f1bd45" stroke-width="2" />
  </g>
  <g class="mascot-face mascot-face-help">
    <rect x="26" y="27" width="4" height="5" fill="#c8f900" /><rect x="35" y="27" width="4" height="5" fill="#c8f900" />
    <path d="M29 37h6" stroke="#f1bd45" stroke-width="2" />
    <rect x="48" y="9" width="10" height="10" fill="#faf9f6" stroke="#101010" /><path d="M51 12h4m-2 0v3m0 2v.5" stroke="#101010" stroke-width="1.5" />
  </g>
  <g class="mascot-face mascot-face-recommendation">
    <rect x="26" y="27" width="4" height="5" fill="#c8f900" /><rect x="35" y="27" width="4" height="5" fill="#c8f900" />
    <path d="M27 35h3v2h4v-2h3" fill="none" stroke="#c8f900" stroke-width="2" />
    <path d="M52 9v9m-4-4h8" stroke="#66c86a" stroke-width="2" />
  </g>
  <g class="mascot-face mascot-face-difficulty">
    <path d="m25 28 4 1m6-1 4-1" stroke="#f1bd45" stroke-width="2" />
    <rect x="26" y="31" width="4" height="4" fill="#c8f900" /><rect x="35" y="31" width="4" height="4" fill="#c8f900" />
    <path d="M29 37h6" stroke="#f1bd45" stroke-width="2" />
    <rect x="50" y="10" width="5" height="5" fill="#f1bd45" />
  </g>
  <rect x="25" y="46" width="5" height="3" fill="#101010" /><rect x="34" y="46" width="5" height="3" fill="#101010" />
</svg>

<style>
  .drills-mascot { flex: 0 0 auto; overflow: visible; }
  .mascot-face { display: none; }
  [data-mood="welcome"] .mascot-face-welcome,
  [data-mood="thinking"] .mascot-face-thinking,
  [data-mood="encouragement"] .mascot-face-encouragement,
  [data-mood="success"] .mascot-face-success,
  [data-mood="help"] .mascot-face-help,
  [data-mood="recommendation"] .mascot-face-recommendation,
  [data-mood="difficulty"] .mascot-face-difficulty { display: initial; }
  @media (prefers-reduced-motion: no-preference) {
    [data-mood="thinking"] { animation: mascot-think 1.8s ease-in-out infinite; }
    @keyframes mascot-think { 50% { transform: translateY(-2px) rotate(2deg); } }
  }
</style>
