---
interface Props {
  id: string;
  value: number;
  max: number;
  label: string;
}

const { id, value, max, label } = Astro.props;
const radius = 17;
const circumference = 2 * Math.PI * radius;
const safeMax = Math.max(1, max);
const safeValue = Math.max(0, Math.min(value, safeMax));
const offset = circumference * (1 - safeValue / safeMax);
---

<svg class="progress-ring" id={id} viewBox="0 0 44 44" role="img" aria-label={label} data-progress-ring data-value={safeValue} data-max={safeMax}>
  <circle class="progress-ring-track" cx="22" cy="22" r={radius} />
  <circle class="progress-ring-value" cx="22" cy="22" r={radius} stroke-dasharray={circumference} stroke-dashoffset={offset} />
  <text class="progress-ring-label" x="22" y="22" dominant-baseline="central" text-anchor="middle">{safeValue}/{safeMax}</text>
</svg>
