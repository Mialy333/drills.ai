---
import "../styles/global.css";
import { href, type Lang } from "../lib/drills";
interface Props { lang: Lang; title: string; path: string; section: string; track?: string; activeId?: string; showCatalogSidebar?: boolean; }
const { lang, title, path, section } = Astro.props;
const fr = lang === "fr";
const other = fr ? "en" : "fr";
const links = [
  { path: "/", section: "home", title: fr ? "Accueil" : "Home" },
  { path: "/apply/", section: "apply", title: fr ? "Ma candidature" : "My application" },
  { path: "/prepare/", section: "prepare", title: fr ? "Entretien" : "Interview" },
  { path: "/progress/", section: "progress", title: fr ? "Mon suivi" : "My progress" },
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | DRILLS.ai</title>
  <meta name="description" content={fr ? "Prépare ta candidature à un premier poste d’Agent Engineer à partir de ton parcours et de preuves concrètes." : "Prepare your first Agent Engineer application from your experience and concrete evidence."} />
  <link rel="icon" href={href("/icons/icon.svg")} type="image/svg+xml" />
  <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem("drills.theme") === "dark" ? "dark" : "light"; } catch { document.documentElement.dataset.theme = "light"; }</script>
</head>
<body data-lang={lang} data-base={href("/")}>
  <a class="skip" href="#main">{fr ? "Aller au contenu" : "Skip to content"}</a>
  <header class="bar">
    <a class="brand" href={href(`/${lang}/`)}><img src={href("/icons/icon.svg")} alt="" width="28" height="28" /><span>DRILLS.ai</span></a>
    <nav class="bar-nav" aria-label={fr ? "Navigation principale" : "Main navigation"}>
      {links.map(link => <a href={href(`/${lang}${link.path}`)} aria-current={section === link.section ? "page" : undefined}>{link.title}</a>)}
    </nav>
    <div class="bar-tools"><a class="tool" href={href(`/${other}${path}`)} hreflang={other}>{other.toUpperCase()}</a><button class="tool" id="theme-toggle" type="button">{fr ? "Clair / sombre" : "Light / dark"}</button></div>
  </header>
  <div class="shell"><main id="main" class="main" tabindex="-1"><slot /><footer class="foot">{fr ? "DRILLS.ai · Ta prochaine opportunité, à partir de ton parcours." : "DRILLS.ai · Your next opportunity, built on your experience."}</footer></main></div>
  <nav class="tabbar" aria-label={fr ? "Navigation mobile" : "Mobile navigation"}>
    {links.map(link => <a href={href(`/${lang}${link.path}`)} aria-current={section === link.section ? "page" : undefined}><span>{link.title}</span></a>)}
  </nav>
  <a class="back-to-top" href="#main">{fr ? "↑ Revenir en haut" : "↑ Back to top"}</a>
  <script>
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = theme;
      try { localStorage.setItem("drills.theme", theme); } catch {}
    });
    if ("serviceWorker" in navigator) {
      if (import.meta.env.DEV) {
        // Do not let a previous production worker serve the old generator in dev.
        navigator.serviceWorker.getRegistrations().then(registrations => {
          const base = new URL(document.body.dataset.base ?? "/", location.origin).href;
          for (const registration of registrations) if (registration.scope === base) void registration.unregister();
        });
      } else {
        void navigator.serviceWorker.register(`${document.body.dataset.base}sw.js`).catch(() => {});
      }
    }
  </script>
</body>
</html>
