---
import App from "../../layouts/App.astro";
import { drills, LANGS, TRACKS, type Lang } from "../../lib/drills";
import { ui } from "../../lib/i18n";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const titles = Object.fromEntries(
  TRACKS.flatMap((track) => drills(track, lang).map((d) => [`${track}:${d.id}`, d.title])),
);
const strings = {
  delete: t.deleteEntry,
  copied: t.copied,
  importDone: t.importDone(999).replace("999", "{n}"),
  importError: t.importError,
};
---

<App lang={lang} title={t.journalTitle} path="/journal/" section="journal">
  <section class="block journal" id="journal" data-titles={JSON.stringify(titles)} data-strings={JSON.stringify(strings)}>
    <h1>{t.journalTitle}</h1>
    <p class="lead">{t.journalLead}</p>

    <div class="filters" role="group" aria-label={lang === "fr" ? "Filtrer par langage" : "Filter by language"}>
      <button type="button" class="filter" data-filter="all" aria-pressed="true">{t.filterAll}</button>
      {TRACKS.map((track) => (
        <button type="button" class="filter" data-filter={track} aria-pressed="false">{t.tracks[track].name}</button>
      ))}
    </div>

    <p class="empty" id="journal-empty">{t.journalEmpty}</p>
    <ol class="log-list" id="journal-list"></ol>
    <p class="note" id="journal-note" hidden>{t.starNote}</p>
  </section>

  <section class="block transfer" aria-labelledby="transfer-h">
    <h2 id="transfer-h">{t.transferTitle}</h2>
    <p class="lead">{t.transferLead}</p>
    <div class="journal-tools">
      <button class="btn" type="button" id="copy">{t.copyBtn}</button>
      <button class="btn" type="button" id="export">{t.exportBtn}</button>
      <label class="btn">
        {t.importBtn}
        <input type="file" id="import" accept="application/json,.json" class="visually-hidden" />
      </label>
    </div>
    <label class="field">
      <span>{t.pasteLabel}</span>
      <textarea id="paste" rows="3" spellcheck="false"></textarea>
    </label>
    <button class="btn" type="button" id="paste-add">{t.pasteBtn}</button>
  </section>
</App>
