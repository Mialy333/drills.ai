---
import { href, LANGS } from "../../lib/drills";
export function getStaticPaths() { return LANGS.map(lang => ({params: {lang}})); }
const target = href(`/${Astro.params.lang}/progress/`);
---
<html lang={Astro.params.lang}><head><meta charset="utf-8" /><meta http-equiv="refresh" content={`0; url=${target}`} /><link rel="canonical" href={target} /><title>DRILLS.ai</title></head><body><a href={target}>Continuer / Continue</a></body></html>
