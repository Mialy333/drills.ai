---
import App from "../../layouts/App.astro";
import { href, LANGS, type Lang } from "../../lib/drills";
import { ui } from "../../lib/i18n";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
---

<App lang={lang} title={t.brand} path="/" section="home">
  <section class="welcome">
    <div class="welcome-text">
      <p class="home-kicker">{lang === "fr" ? "PARCOURS PYTHON · AI ENGINEERING" : "PYTHON PATH · AI ENGINEERING"}</p>
      <h1 class="welcome-title">{t.welcomeTitle}</h1>
      <p class="welcome-lead">{t.welcomeLead}</p>
      <ol class="home-steps" aria-label={lang === "fr" ? "Ton parcours" : "Your learning path"}>
        {t.welcomeHow.map((step, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{step}</li>)}
      </ol>
    </div>
  </section>

  <section class="resume-panel" id="resume-panel" hidden aria-labelledby="resume-title">
    <p class="home-kicker">{lang === "fr" ? "REPRENDRE" : "PICK UP WHERE YOU LEFT OFF"}</p>
    <h2 id="resume-title">{lang === "fr" ? "Ta dernière session" : "Your last session"}</h2>
    <p id="resume-detail">{lang === "fr" ? "Retrouve ton dernier exercice." : "Return to your most recent exercise."}</p>
    <a class="btn btn-primary" id="resume-link" href={href(`/${lang}/python/`)}>{lang === "fr" ? "Reprendre" : "Continue"}</a>
  </section>

  <section class="journey-grid" aria-label={lang === "fr" ? "Choisis ton point de départ" : "Choose your starting point"}>
    <a class="journey-card journey-card-primary" href={href(`/${lang}/assess/`)}>
      <span class="journey-index">01 / SKILL CHECK</span>
      <h2>{lang === "fr" ? "Je veux situer mon niveau" : "I want to check my level"}</h2>
      <p>{lang === "fr" ? "Réponds à 8 questions pour obtenir un premier repère sur tes compétences d'AI Agent Engineer." : "Answer 8 questions for an initial snapshot of your AI Agent Engineer skills."}</p>
      <span class="journey-action">{lang === "fr" ? "Faire le diagnostic" : "Start the diagnostic"}<span aria-hidden="true">↗</span></span>
    </a>
    <a class="journey-card journey-card-secondary" href={href(`/${lang}/generate/`)}>
      <span class="journey-index">02 / JOB TARGET</span>
      <h2>{lang === "fr" ? "J'ai une offre d'emploi" : "I have a job posting"}</h2>
      <p>{lang === "fr" ? "Repère les compétences demandées et prépare-toi avec un exercice Python adapté." : "Map the role's requirements and prepare with a tailored Python exercise."}</p>
      <span class="journey-action">{lang === "fr" ? "Préparer cette offre" : "Prepare for this role"}<span aria-hidden="true">↗</span></span>
    </a>
    <a class="journey-card journey-card-sample" id="sample-drill-link" href={href(`/${lang}/python/dynamic-job/`)}>
      <span class="journey-index">00 / QUICK START</span>
      <h2>{lang === "fr" ? "Je veux essayer tout de suite" : "I want to try it now"}</h2>
      <p>{lang === "fr" ? "Lance un mini-exercice Python prêt à l'emploi. Pas de compte, pas de clé API, pas d'offre à coller." : "Try a ready-to-go Python exercise. No account, API key, or job posting needed."}</p>
      <span class="journey-action">{lang === "fr" ? "Essayer un exercice gratuit" : "Try a free sample drill"}<span aria-hidden="true">↗</span></span>
    </a>
  </section>
  <p id="sample-drill-error" class="note is-error" role="status" hidden>{lang === "fr" ? "Le stockage local est indisponible. Autorise le stockage pour lancer l'exercice d'exemple." : "Local storage is unavailable. Allow local storage to launch the sample drill."}</p>

  <p class="home-privacy">{lang === "fr" ? "Aucun compte requis · progression conservée sur cet appareil · Python s'exécute dans ton navigateur" : "No account required · progress stays on this device · Python runs in your browser"}</p>

  <script>
    type SavedAttempt = { track: string; id: string; date: string };
    const resumePanel = document.getElementById("resume-panel");
    const resumeLink = document.getElementById("resume-link") as HTMLAnchorElement | null;
    const resumeDetail = document.getElementById("resume-detail");
    const base = document.body.dataset.base ?? "/";
    const lang = document.body.dataset.lang ?? "en";
    const copy = JSON.parse(document.body.dataset.strings ?? "{}") as { resumePractice?: string };

    const sampleLink = document.getElementById("sample-drill-link") as HTMLAnchorElement | null;
    const sampleError = document.getElementById("sample-drill-error");
    sampleLink?.addEventListener("click", (event) => {
      event.preventDefault();
      const sample = {
        drill_id: "sample-tags",
        family: "Debugging",
        title: lang === "fr" ? "Mini-exercice : normaliser des tags" : "Sample drill: normalize tags",
        context: lang === "fr"
          ? "Une API reçoit des tags saisis par des utilisateurs. Les espaces et les doublons créent des catégories incohérentes."
          : "An API receives user-submitted tags. Whitespace and duplicates create inconsistent categories.",
        mission: lang === "fr"
          ? "Corrige normalize_tags pour supprimer les valeurs vides, retirer les espaces autour des tags, convertir en minuscules et dédupliquer les résultats."
          : "Fix normalize_tags to discard blank values, trim whitespace, lowercase tags, and remove duplicates.",
        broken_code: `def normalize_tags(tags):
    return [tag.strip().lower() for tag in tags if tag]`,
        fixed_solution: `def normalize_tags(tags):
    return sorted({tag.strip().lower() for tag in tags if tag and tag.strip()})`,
        hidden_test_harness: `def test_normalize_tags():
    assert normalize_tags([" AI ", "ai", "", " Python "]) == ["ai", "python"]
    assert normalize_tags(["  ", "PYTHON"]) == ["python"]`,
        multiple_choice: {
          question: lang === "fr" ? "Pourquoi faut-il tester tag.strip() et pas seulement tag ?" : "Why check tag.strip() instead of only tag?",
          options: lang === "fr"
            ? ["Une chaîne composée d'espaces est truthy en Python", "strip() trie automatiquement la liste", "strip() transforme la chaîne en nombre", "Les chaînes vides provoquent toujours une exception"]
            : ["A whitespace-only string is truthy in Python", "strip() automatically sorts the list", "strip() converts the string to a number", "Empty strings always raise an exception"],
          correct_answer_index: 0,
          reasoning: lang === "fr"
            ? "Une chaîne contenant des espaces n'est pas vide pour Python : il faut vérifier le résultat de strip()."
            : "A string containing spaces is not empty to Python, so check the result of strip()."
        },
        model_answer_ideas: lang === "fr"
          ? ["Filtrer les valeurs vides ou composées d'espaces", "Normaliser avec strip() et lower()", "Dédupliquer les tags"]
          : ["Filter empty or whitespace-only values", "Normalize with strip() and lower()", "Deduplicate tags"]
      };
      try {
        localStorage.setItem(`DRILLS_DYNAMIC_JOB_DATA_${lang.toUpperCase()}`, JSON.stringify(sample));
        window.location.assign(sampleLink.href);
      } catch {
        if (sampleError) sampleError.hidden = false;
      }
    });

    try {
      const stored: unknown = JSON.parse(localStorage.getItem("drills.journal") ?? "null");
      if (Array.isArray(stored)) {
        const attempts = stored.filter((item): item is SavedAttempt =>
          !!item && typeof item === "object" &&
          typeof item.track === "string" && typeof item.id === "string" && typeof item.date === "string",
        );
        const latest = attempts.sort((a, b) => b.date.localeCompare(a.date))[0];
        if (latest && resumePanel && resumeLink && resumeDetail) {
          let title = `${latest.track} · ${latest.id.toUpperCase()}`;
          if (latest.id === "dynamic-job") {
            try {
              const dynamic: unknown = JSON.parse(localStorage.getItem(`DRILLS_DYNAMIC_JOB_DATA_${lang.toUpperCase()}`) ?? "null");
              if (dynamic && typeof dynamic === "object" && "title" in dynamic && typeof dynamic.title === "string") title = dynamic.title;
            } catch {}
          }
          resumeLink.href = `${base}${lang}/${latest.track}/${latest.id}/`;
          resumeLink.textContent = copy.resumePractice?.replace("{title}", title) ?? title;
          resumeDetail.textContent = title;
          resumePanel.hidden = false;
        }
      }
    } catch {
      // The learning path stays usable when local storage is unavailable.
    }
  </script>
</App>
