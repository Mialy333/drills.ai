---
import App from "../../layouts/App.astro";
import { drills, href, LANGS, READY_TRACKS, TRACKS, type Lang } from "../../lib/drills";
import { ui } from "../../lib/i18n";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
---

<App lang={lang} title={t.brand} path="/" section="home">
  <section class="welcome">
    <img class="welcome-art" src={href("/hero.webp")} alt={t.heroAlt} width="1504" height="628" fetchpriority="high" />
    <div class="welcome-text">
      <h1 class="welcome-title">{t.welcomeTitle}</h1>
      <p class="welcome-lead">{t.welcomeLead}</p>
      <ol class="steps">
        {t.welcomeHow.map((s) => <li>{s}</li>)}
      </ol>
    </div>
  </section>

  <section class="generator-cta" aria-label={lang === "fr" ? "Générateur de drills" : "Drill generator"}>
    <div>
      <p class="generator-cta-kicker">{lang === "fr" ? "NOUVEAU // DRILL PERSONNALISÉ" : "NEW // CUSTOM DRILL"}</p>
      <h2>{lang === "fr" ? "Entraînez-vous sur votre prochain poste" : "Train for your next role"}</h2>
      <p>{lang === "fr" ? "Transformez une offre d’emploi en exercice technique interactif." : "Turn a job description into an interactive technical exercise."}</p>
    </div>
    <a class="btn btn-primary btn-big generator-cta-button" href={href(`/${lang}/generate/`)}>
      {lang === "fr" ? "Créer un drill" : "Generate a drill"} <span aria-hidden="true">↗</span>
    </a>
  </section>

  <section class="tracks" aria-labelledby="tracks-h">
    <h2 id="tracks-h">{t.chooseTrack}</h2>
    <div class="track-grid">
      {TRACKS.map((track) => {
        const ready = READY_TRACKS.includes(track);
        const total = drills(track, lang).length;
        return ready ? (
          <a class={`track track-${track}`} href={href(`/${lang}/${track}/`)} data-track-card={track} data-total={total}
             data-progress-template={t.progressOf(999, total).replace("999", "{n}")} data-empty={t.noProgress}>
            <span class="track-badge" aria-hidden="true">{track === "python" ? "py" : "ts"}</span>
            <span class="track-name">{t.tracks[track].name}</span>
            <span class="track-blurb">{t.tracks[track].blurb}</span>
            <span class="track-progress"><span class="track-meter"><span></span></span><span class="track-count">{t.noProgress}</span></span>
          </a>
        ) : (
          <div class={`track track-${track} is-soon`} aria-disabled="true">
            <span class="track-badge" aria-hidden="true">{track === "python" ? "py" : "ts"}</span>
            <span class="track-name">{t.tracks[track].name} <span class="soon">{t.soon}</span></span>
            <span class="track-blurb">{t.tracks[track].blurb}</span>
          </div>
        );
      })}
    </div>
  </section>
</App>
