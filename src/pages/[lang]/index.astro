---
import App from "../../layouts/App.astro";
import { href, LANGS, type Lang } from "../../lib/drills";
export function getStaticPaths() { return LANGS.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const fr = lang === "fr";
---
<App lang={lang} title="DRILLS.ai" path="/" section="home">
  <div class="home-page">
    <section class="welcome" aria-labelledby="welcome-title">
      <div class="welcome-text">
        <p class="home-kicker">{fr ? "TON PREMIER POSTE D’AGENT ENGINEER" : "YOUR FIRST AGENT ENGINEER ROLE"}</p>
        <h1 class="welcome-title" id="welcome-title">{fr ? "Décroche tes premiers entretiens d’Agent Engineer." : "Land your first Agent Engineer interviews."}</h1>
        <p class="welcome-lead">{fr ? "Importe ton CV, choisis une offre et prépare une candidature qui met ton parcours en valeur. Pour un stage, une alternance ou un premier emploi." : "Upload your CV, choose an opening and build an application that highlights your experience. For an internship, apprenticeship or first job."}</p>
        <div class="welcome-actions"><a id="home-start" class="btn btn-primary" href={href(`/${lang}/apply/?step=profile`)}>{fr ? "Commencer ici →" : "Start here →"}</a><a id="home-edit-profile" hidden href={href(`/${lang}/apply/?step=profile`)}>{fr ? "Modifier mon profil" : "Edit my profile"}</a></div>
        <p id="home-resume-note" class="welcome-note">{fr ? "Première étape : ton profil. Aucun compte à créer pour ce MVP." : "First step: your profile. No account needed for this MVP."}</p>
        <p class="welcome-note">{fr ? "Tes expériences passées, tes projets et tes formations deviennent des preuves concrètes. Tu gardes la main sur les textes." : "Your previous experience, projects and education become concrete evidence. You stay in control of the wording."}</p>
      </div>
    </section>

  </div>
  <script>import "../../scripts/home";</script>
</App>
