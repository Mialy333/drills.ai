---
import App from "../../../layouts/App.astro";
import { href, LANGS, READY_TRACKS, type Lang, type Track } from "../../../lib/drills";
import { ui } from "../../../lib/i18n";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => READY_TRACKS.map((track) => ({ params: { lang, track } })));
}

const lang = Astro.params.lang as Lang;
const track = Astro.params.track as Track;
const t = ui[lang];
const title = lang === "fr" ? "Prépare ton prochain poste" : "Prepare for your next role";
---

<App lang={lang} title={title} path={`/${track}/`} section="home">
  <section class="welcome">
    <div class="welcome-text">
      <p class="home-kicker">{t.tracks[track].name} · AI ENGINEERING</p>
      <h1 class="welcome-title">{title}</h1>
      <p class="welcome-lead">{lang === "fr"
        ? "Construis un parcours de préparation à partir de tes compétences ou d'une offre d'emploi. Chaque exercice est adapté à ton objectif."
        : "Build a preparation path from your skills or a job posting. Each exercise is tailored to your goal."}</p>
    </div>
  </section>

  <section class="journey-grid" aria-label={lang === "fr" ? "Choisis ton point de départ" : "Choose your starting point"}>
    <a class="journey-card journey-card-primary" href={href(`/${lang}/assess/`)}>
      <span class="journey-index">01 / SKILL CHECK</span>
      <h2>{lang === "fr" ? "Situer mon niveau" : "Check my level"}</h2>
      <p>{lang === "fr" ? "Fais le diagnostic pour identifier tes priorités." : "Take the diagnostic to identify your priorities."}</p>
      <span class="journey-action">{lang === "fr" ? "Faire le diagnostic" : "Start the diagnostic"}<span aria-hidden="true">↗</span></span>
    </a>
    <a class="journey-card journey-card-secondary" href={href(`/${lang}/generate/`)}>
      <span class="journey-index">02 / JOB TARGET</span>
      <h2>{lang === "fr" ? "Préparer une offre d'emploi" : "Prepare for a job posting"}</h2>
      <p>{lang === "fr" ? "Colle l'annonce pour obtenir une feuille de route et un exercice Python ciblé." : "Paste the posting for a roadmap and a tailored Python exercise."}</p>
      <span class="journey-action">{lang === "fr" ? "Préparer cette offre" : "Prepare for this role"}<span aria-hidden="true">↗</span></span>
    </a>
  </section>
</App>
