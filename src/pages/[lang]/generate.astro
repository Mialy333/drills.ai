---
import App from "../../layouts/App.astro";
import { href, LANGS, type Lang } from "../../lib/drills";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<App lang={lang} title={lang === "fr" ? "Générateur de drills" : "Drill generator"} path="/generate/" section="generate">
  <section class="generator-page" aria-labelledby="generator-title">
    <header class="generator-head">
      <p class="generator-kicker">{lang === "fr" ? "PROTOCOLE // GÉNÉRATEUR" : "PROTOCOL // GENERATOR"}</p>
      <h1 id="generator-title">{lang === "fr" ? "Générateur de drills dynamiques" : "Dynamic drill generator"}</h1>
      <p>{lang === "fr" ? "Créez un exercice technique personnalisé à partir d’une offre d’emploi." : "Create a custom technical exercise from a job description."}</p>
    </header>
    <style>
        .generator-page { max-width: 860px; margin: 0 auto; }
        .generator-head { margin-bottom: 28px; }
        .generator-head h1 { color: var(--ink); text-shadow: 0 0 18px color-mix(in srgb, var(--accent) 55%, transparent); }
        .generator-head > p:last-child { color: var(--muted); }
        .generator-kicker { color: var(--ok); font: 1rem var(--pixel); letter-spacing: .08em; }
        .generator-card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-m); padding: 24px; margin-bottom: 20px; box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 10%, transparent); }
        label { display: block; font-weight: bold; margin-bottom: 8px; font-family: var(--mono); color: var(--muted); }
        .generator-card input[type="password"], .generator-card textarea {
            width: 100%;
            background: var(--code-bg);
            border: 1px solid var(--line);
            border-radius: 6px;
            color: var(--ink);
            padding: 10px;
            box-sizing: border-box;
            margin-bottom: 15px;
        }
        .generator-card textarea { font-family: var(--mono); height: 180px; }
        .generator-card button {
            background: var(--accent);
            color: var(--accent-ink);
            border: 1px solid var(--accent);
            border-radius: 6px;
            padding: 12px 20px;
            font-weight: bold;
            cursor: pointer;
            font-family: monospace;
            width: 100%;
        }
        .generator-card button:hover { filter: brightness(1.1); }
        #launchDrill { display: none; margin-top: 14px; background: var(--code-bg); border-color: var(--ok); color: var(--ok); box-shadow: 0 0 14px color-mix(in srgb, var(--ok) 24%, transparent); }
        #launchDrill.is-ready { display: block; }
        .terminal-log { background: var(--code-bg); border: 1px solid var(--ok); color: var(--ok); font-family: var(--mono); padding: 15px; border-radius: var(--radius-s); display: none; white-space: pre-wrap; margin-top: 20px; overflow-wrap: anywhere; }
    </style>

    <!-- 1. Key Storage Configuration Box -->
    <div class="generator-card">
        <label for="apiKey">> ENTER YOUR OPENAI_API_KEY (Stored locally in your browser)</label>
        <input type="password" id="apiKey" placeholder="sk-proj-..." />
        <button id="saveKeyBtn" style="background-color: #21262d; border-color: #30363d; margin-top: 5px;">Save Token Regionally</button>
    </div>

    <!-- 2. Job Ingestion Box -->
    <div class="generator-card">
        <label for="jobDescription">> PASTE TARGET JOB DESCRIPTION</label>
        <textarea id="jobDescription" placeholder="Paste the text from LinkedIn or Welcome to the Jungle here... Needs explicit Python requirements."></textarea>
        
        <button id="generateBtn">⚡ RUN PROTOCOL: SYNTHESIZE CUSTOM DRILL</button>
        <button id="launchDrill" type="button" data-href={href(`/${lang}/python/dynamic-job/`)}>▶ LAUNCH DRILL SIMULATION</button>
    </div>

    <!-- 3. Output / Terminal Sandbox Tracker -->
    <div id="terminalLog" class="terminal-log"></div>

    <script>
        import OpenAI from "openai";
        import { zodResponseFormat } from "openai/helpers/zod";
        import { z } from "zod";

        // 1. Re-declare the identical strict Pydantic blueprint into Zod format
        const MultipleChoiceSchema = z.object({
            question: z.string(),
            options: z.array(z.string()),
            correct_answer_index: z.number(),
            reasoning: z.string()
        });

        const DynamicDrillSchema = z.object({
            drill_id: z.string(),
            family: z.enum(["Debugging", "Refactoring", "Code reading"]),
            title: z.string(),
            context: z.string(),
            mission: z.string(),
            broken_code: z.string(),
            fixed_solution: z.string(),
            hidden_test_harness: z.string(),
            multiple_choice: MultipleChoiceSchema,
            model_answer_ideas: z.array(z.string())
        });

        // System instructions to maintain maximum developer test rigor
        const SYSTEM_PROMPT = `You are an Elite AI Engineering Technical Interviewer and Software Architect. 
Your role is to ingest an unstructured Job Description and synthesize a rigorous, production-grade coding puzzle (Drill) for the player.
You must follow these instructions with absolute zero-tolerance for fluff:
1. NO AI SLOP: The 'broken_code' must look like it was written by an engineer in a hurry or an unvalidated agent system. Use realistic enterprise patterns (e.g., fastAPI middleware, database pool handling, multi-agent state race conditions).
2. LOGICAL COHERENCE: The 'hidden_test_harness' must execute flawlessly in Python 3. It must FAIL when evaluated against the 'broken_code' and PASS when evaluated against the 'fixed_solution'.
3. INDUSTRIAL FOCUS: Focus heavily on modern failures—prompt injection vulnerabilities, asynchronous processing locks, vector memory leakage, and deterministic data schema bypasses.`;

        // UI Element Selectors
        const apiKeyInput = document.querySelector<HTMLInputElement>("#apiKey");
        const saveKeyBtn = document.querySelector<HTMLButtonElement>("#saveKeyBtn");
        const jobDescriptionInput = document.querySelector<HTMLTextAreaElement>("#jobDescription");
        const generateBtn = document.querySelector<HTMLButtonElement>("#generateBtn");
        const launchDrill = document.querySelector<HTMLButtonElement>("#launchDrill");
        const terminalLog = document.querySelector<HTMLDivElement>("#terminalLog");

        function logToTerminal(message: string) {
            if (terminalLog) {
                terminalLog.style.display = "block";
                terminalLog.textContent += `\n> ${message}`;
            }
        }

        // On boot: check if a key already exists in browser storage
        const cachedKey = localStorage.getItem("DRILLS_OPENAI_KEY");
        if (cachedKey && apiKeyInput) {
            apiKeyInput.value = cachedKey;
            logToTerminal("Local cache state check: OpenAI Token decrypted and mounted.");
        }

        launchDrill?.addEventListener("click", () => {
            const target = launchDrill.dataset.href;
            if (target) window.location.assign(target);
        });

        // Save token handler
        saveKeyBtn?.addEventListener("click", () => {
            if (!apiKeyInput) return;
            const key = apiKeyInput.value.trim();
            if (key) {
                localStorage.setItem("DRILLS_OPENAI_KEY", key);
                alert("Token safely cached in your local browser sandbox!");
            }
        });

        // Core Generation Pipeline
        generateBtn?.addEventListener("click", async () => {
            const key = apiKeyInput?.value.trim() ?? "";
            const jobDesc = jobDescriptionInput?.value.trim() ?? "";

            if (!key || !jobDesc) {
                alert("Error: Both API Key and Job Description fields are strictly mandatory.");
                return;
            }

            if (terminalLog) terminalLog.textContent = ""; // Clear logs
            logToTerminal("Executing network sandbox tunnel to OpenAI API...");

            try {
                // Initialize client targeting browser runtime clearance
                const openai = new OpenAI({ apiKey: key, dangerouslyAllowBrowser: true });

                logToTerminal("Sending context payload... Enforcing strict validation schema layout.");
                
                const completion = await openai.chat.completions.create({
                    model: "gpt-4o-2024-08-06",
                    messages: [
                        { role: "system", content: SYSTEM_PROMPT },
                        { role: "user", content: jobDesc }
                    ],
                    response_format: zodResponseFormat(DynamicDrillSchema, "drill_generation")
                });

                const rawJson = completion.choices[0]?.message.content;
                if (!rawJson) throw new Error("Empty response received from OpenAI.");
                const validation = DynamicDrillSchema.safeParse(JSON.parse(rawJson));
                if (!validation.success) throw new Error(`Invalid drill response: ${validation.error.message}`);
                const structuralDrillJson = validation.data;
                localStorage.setItem("DRILLS_DYNAMIC_JOB_DATA", JSON.stringify(structuralDrillJson));
                launchDrill?.classList.add("is-ready");
                logToTerminal("🟢 Success! Structured response received with zero AI Slop.");
                
                // Print the clean generated JSON object directly to the screen
                logToTerminal(JSON.stringify(structuralDrillJson, null, 2));

                // NEXT STEP SUNDAY: Inject this JSON straight into your application's active play state!
                logToTerminal("Ready for local injection gate.");

            } catch (err: unknown) {
                logToTerminal(`❌ System Failure: ${err instanceof Error ? err.message : String(err)}`);
            }
        });
    </script>
  </section>
</App>
