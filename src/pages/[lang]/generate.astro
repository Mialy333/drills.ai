---
import App from "../../layouts/App.astro";
import { href, LANGS, type Lang } from "../../lib/drills";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<App lang={lang} title={lang === "fr" ? "Comparer mon profil à une offre" : "Match my profile to a role"} path="/generate/" section="generate">
  <section class="generator-page" aria-labelledby="generator-title">
    <header class="generator-head">
      <p class="generator-kicker">{lang === "fr" ? "OFFRE CIBLE · FRANCE" : "TARGET POSTING · FRANCE"}</p>
      <h1 id="generator-title">{lang === "fr" ? "Commence par l’annonce" : "Start with the job posting"}</h1>
      <p>{lang === "fr" ? "Colle une offre de stage, d’alternance ou de premier poste en AI Agent Engineering. Compare ses compétences à tes expériences, puis prépare un exercice Python ciblé." : "Paste an AI Agent Engineering internship, apprenticeship, or entry-level posting. Compare its skills with your experience, then prepare a targeted Python exercise."}</p>
      <p>{lang === "fr" ? "Pas besoin de CV complet : décris une expérience pertinente. Le score indique la couverture des éléments écrits, pas tes chances d’être recruté·e." : "No full CV needed: describe one relevant experience. The score measures written evidence coverage, not your chance of being hired."}</p>
    </header>
    <style>
        .generator-page { max-width: 860px; margin: 0 auto; }
        .generator-head { margin-bottom: 28px; }
        .generator-head h1 { color: var(--ink); text-shadow: 0 0 18px color-mix(in srgb, var(--accent) 55%, transparent); }
        .generator-head > p:last-child { color: var(--muted); }
        .generator-kicker { color: var(--ok); font: 1rem var(--pixel); letter-spacing: .08em; }
        .generator-card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-m); padding: 24px; margin-bottom: 20px; box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 10%, transparent); }
        label { display: block; font-weight: bold; margin-bottom: 8px; font-family: var(--mono); color: var(--muted); }
        .generator-card textarea {
            width: 100%;
            background: var(--code-bg);
            border: 1px solid var(--line);
            border-radius: 6px;
            color: var(--ink);
            padding: 10px;
            box-sizing: border-box;
            margin-bottom: 15px;
        }
        .generator-card textarea { font-family: var(--mono); height: 180px; }
        .generator-card #candidateSchools { height: auto; }
        .generator-card input, .generator-card select { width: 100%; min-height: 44px; margin: 0 0 14px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--code-bg); color: var(--ink); font: inherit; }
        .candidate-fields { display: grid; gap: 8px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line); }
        .candidate-fields h2 { margin: 0; font-size: 1.2rem; }
        .candidate-fields > p { margin: 0 0 4px; color: var(--muted); font-size: .92rem; }
        .candidate-experiences { display: grid; gap: 14px; }
        .candidate-experience { min-width: 0; margin: 0; padding: 16px; border: 1px solid var(--line); border-radius: var(--radius-s); }
        .candidate-experience legend { padding: 0 6px; color: var(--ink); font-weight: 700; }
        .candidate-experience label { margin-top: 8px; }
        .candidate-experience textarea { height: 100px; }
        .candidate-experience .remove-experience { width: auto; margin-top: 8px; background: var(--raise); color: var(--ink); border-color: var(--line); }
        .add-experience { width: auto !important; justify-self: start; background: var(--raise) !important; color: var(--ink) !important; border-color: var(--line) !important; }
        .profile-actions { display: flex; flex-wrap: wrap; gap: 10px; }
        .generator-card .profile-actions button { width: auto; flex: 1 1 180px; background: var(--raise); color: var(--ink); border-color: var(--line); }
        .profile-status { min-height: 1.4em; margin: 0; color: var(--muted); font-size: .9rem; }
        .match-card { margin: 24px 0; padding: 18px; border: 1px solid var(--line); border-radius: var(--radius-s); background: var(--raise); }
        .match-card[hidden] { display: none; }
        .match-score { display: flex; align-items: baseline; gap: 8px; margin: 8px 0; color: var(--ok); font: 2rem var(--pixel); }
        .match-explainer { color: var(--muted); line-height: 1.55; }
        .match-skills { display: grid; gap: 8px; padding: 0; list-style: none; }
        :global(.match-skills li) { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); }
        :global(.match-skills small) { color: var(--muted); text-align: right; }
        :global(.match-matched) { color: var(--ok); }
        :global(.match-partial) { color: var(--warn); }
        :global(.match-not-found) { color: var(--muted); }
        .generator-card button {
            background: var(--accent);
            color: var(--accent-ink);
            border: 1px solid var(--accent);
            border-radius: 6px;
            padding: 12px 20px;
            font-weight: bold;
            cursor: pointer;
            font-family: monospace;
            width: 100%;
        }
        .generator-card button:hover { filter: brightness(1.1); }
        .generator-help { margin: 0 0 14px; color: var(--muted); font-size: .9rem; }
        .roadmap-panel { padding: 24px; border: 1px solid var(--ok); border-radius: var(--radius-m); background: var(--panel); margin-bottom: 20px; box-shadow: 0 0 24px color-mix(in srgb, var(--ok) 10%, transparent); }
        .roadmap-panel[hidden] { display: none; }
        .roadmap-panel h2 { margin: 0 0 8px; }
        .roadmap-summary { color: var(--muted); }
        .roadmap-note { color: var(--muted); font-size: .9rem; }
        .roadmap-skills, .roadmap-steps { display: grid; gap: 12px; padding-left: 24px; }
        :global(.roadmap-skills li) { padding-left: 4px; }
        :global(.roadmap-steps li) { padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--radius-s); background: var(--raise); line-height: 1.45; }
        :global(.roadmap-steps li > strong) { display: block; line-height: 1.35; }
        :global(.roadmap-skills li) { display: grid; grid-template-columns: minmax(0, 1fr) max-content; align-items: center; gap: 6px 12px; }
        :global(.roadmap-skills small), :global(.roadmap-steps small) { display: block; color: var(--muted); margin-top: 3px; }
        :global(.roadmap-skills small) { grid-column: 1 / -1; margin: 4px 0 0; padding-top: 8px; border-top: 1px solid var(--line); line-height: 1.5; }
        :global(.roadmap-steps small) { margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--line); line-height: 1.55; }
        :global(.roadmap-priority) { display: inline-block; padding: 3px 9px; border: 1px solid currentColor; border-radius: 999px; font: .82rem var(--pixel); white-space: nowrap; }
        :global(.roadmap-priority-core) { color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
        :global(.roadmap-priority-important) { color: var(--warn); background: color-mix(in srgb, var(--warn) 12%, transparent); }
        :global(.roadmap-priority-supporting) { color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, transparent); }
        #launchDrill { margin-top: 20px; background: var(--code-bg); border-color: var(--ok); color: var(--ok); box-shadow: 0 0 14px color-mix(in srgb, var(--ok) 24%, transparent); }
        .generator-status { margin: 16px 0 20px; padding: 14px 16px; border: 1px solid var(--line); border-radius: var(--radius-s); background: var(--panel); }
        .generator-status[hidden] { display: none; }
        .generator-status[data-state="busy"] { border-color: var(--accent); }
        .generator-status[data-state="success"] { border-color: var(--ok); color: var(--ok); }
        .generator-status[data-state="error"] { border-color: var(--warn); color: var(--warn); }
    </style>

    <div class="generator-card">
        <label for="jobDescription">{lang === "fr" ? "1. COLLE L'ANNONCE COMPLÈTE" : "1. PASTE THE FULL JOB POSTING"}</label>
        <textarea id="jobDescription" placeholder={lang === "fr" ? "Colle les missions et compétences requises, pas seulement les avantages ou la localisation." : "Include responsibilities and required skills, not only benefits or location."}></textarea>

        <div class="candidate-fields" aria-labelledby="candidate-profile-title">
          <h2 id="candidate-profile-title">{lang === "fr" ? "2. Ajoute quelques éléments de ton parcours" : "2. Add a few details about your background"}</h2>
          <p>{lang === "fr" ? "Ajoute jusqu’à trois expériences ou projets pertinents. N’importe pas ton CV brut : indique seulement les faits que tu veux comparer." : "Add up to three relevant experiences or projects. Don’t paste a raw CV: enter only the facts you want to compare."}</p>
          <div id="candidateExperiences" class="candidate-experiences"></div>
          <button id="addCandidateExperience" class="add-experience" type="button">{lang === "fr" ? "+ Ajouter une expérience" : "+ Add an experience"}</button>
          <label for="candidateSchools">{lang === "fr" ? "École(s) ou formation(s) (facultatif, une par ligne)" : "School(s) or training provider(s) (optional, one per line)"}</label>
          <textarea id="candidateSchools" maxlength="600" rows="2"></textarea>
          <p class="profile-status" id="candidateProfileStatus" role="status" aria-live="polite"></p>
          <div class="profile-actions">
            <button id="exportCandidateProfile" type="button" hidden>{lang === "fr" ? "Exporter mon profil" : "Export my profile"}</button>
            <button id="deleteCandidateProfile" type="button" hidden>{lang === "fr" ? "Supprimer mon profil" : "Delete my profile"}</button>
          </div>
          <p>{lang === "fr" ? "Le profil reste dans ce navigateur pendant 30 jours. Il n’est pas envoyé à l’IA ; seul le texte de l’annonce est transmis au service de génération. Tu peux l’exporter ou le supprimer à tout moment." : "The profile stays in this browser for 30 days. It is not sent to AI; only the posting text goes to the generation service. You can export or delete it at any time."}</p>
        </div>

        <button id="generateBtn" type="button">{lang === "fr" ? "⚡ CALCULER LE MATCH ET PRÉPARER MON EXERCICE" : "⚡ CHECK THE MATCH AND PREPARE MY DRILL"}</button>
        <div id="generatorStatus" class="generator-status" role="status" aria-live="polite" hidden></div>
    </div>

    <section class="roadmap-panel" id="roadmapPanel" hidden aria-live="polite" aria-labelledby="roadmapTitle">
        <p class="generator-kicker">{lang === "fr" ? "PARCOURS DE PRATIQUE" : "PRACTICE PATH"}</p>
        <h2 id="roadmapTitle" tabindex="-1"></h2>
        <p class="roadmap-summary" id="roadmapSummary"></p>
        <div class="match-card" id="candidateMatchPanel" hidden aria-live="polite" aria-labelledby="candidateMatchTitle">
          <h3 id="candidateMatchTitle">{lang === "fr" ? "Couverture des compétences" : "Skill evidence coverage"}</h3>
          <p class="match-score"><span id="candidateMatchScore"></span><span aria-hidden="true">%</span></p>
          <p class="match-explainer" id="candidateMatchSummary"></p>
          <ul class="match-skills" id="candidateMatchSkills"></ul>
          <p class="match-explainer">{lang === "fr" ? "Score heuristique : critères essentiels pondérés davantage. Un élément non retrouvé dans ton texte n’indique pas que tu ne possèdes pas la compétence. Ce score n’est pas une probabilité de recrutement." : "Heuristic score: core requirements carry more weight. A requirement not found in your text does not mean you lack the skill. This is not a hiring probability."}</p>
        </div>
        <h3 id="roadmapSkillsTitle">{lang === "fr" ? "Repères de pratique" : "Practice signals"}</h3>
        <ul class="roadmap-skills" id="roadmapSkills"></ul>
        <h3 id="roadmapStepsTitle">{lang === "fr" ? "Étapes de préparation" : "Preparation steps"}</h3>
        <ol class="roadmap-steps" id="roadmapSteps"></ol>
        <p class="roadmap-note" id="roadmapNote"></p>
        <button id="launchDrill" class="btn btn-primary btn-big" type="button" data-href={href(`/${lang}/python/dynamic-job/`)}>
          {lang === "fr" ? "▶ LANCER L'EXERCICE CIBLÉ" : "▶ LAUNCH THE TAILORED DRILL"}
        </button>
    </section>

    <script>
        import { DynamicDrillSchema, StoredDynamicDrillSchema, type DynamicDrill } from "../../lib/contracts";
        import { apiEndpoint } from "../../lib/api-client";
        import { readLearnerProfile, ASSESSMENT_KEY } from "../../lib/learner";
        import { CandidateProfileInputSchema, createCandidateProfile, deleteCandidateProfile as removeCandidateProfile, readCandidateProfile, writeCandidateProfile, type CandidateProfileInput } from "../../lib/candidate-profile";
        import { matchCandidateToDrill, type CandidateMatchResult } from "../../lib/candidate-match";
        import { createRecommendationProvenance, createStoredRecommendationPlan, provenanceCopy, resolveStoredProvenance, type RecommendationProvenance } from "../../lib/recommendation-provenance";
        import { PILLARS, type SkillPillar } from "../../lib/assessment";
        import type { Lang } from "../../lib/drills";

        // UI Element Selectors
        const jobDescriptionInput = document.querySelector<HTMLTextAreaElement>("#jobDescription");
        const generateBtn = document.querySelector<HTMLButtonElement>("#generateBtn");
        const drillsEndpoint = apiEndpoint("/api/drills");
        const launchDrill = document.querySelector<HTMLButtonElement>("#launchDrill");
        const generatorStatus = document.querySelector<HTMLDivElement>("#generatorStatus");
        const roadmapPanel = document.querySelector<HTMLElement>("#roadmapPanel");
        const roadmapKicker = document.querySelector<HTMLElement>("#roadmapPanel .generator-kicker");
        const roadmapTitle = document.querySelector<HTMLElement>("#roadmapTitle");
        const roadmapSummary = document.querySelector<HTMLElement>("#roadmapSummary");
        const roadmapSkills = document.querySelector<HTMLUListElement>("#roadmapSkills");
        const roadmapSkillsTitle = document.querySelector<HTMLElement>("#roadmapSkillsTitle");
        const roadmapStepsTitle = document.querySelector<HTMLElement>("#roadmapStepsTitle");
        const roadmapSteps = document.querySelector<HTMLOListElement>("#roadmapSteps");
        const roadmapNote = document.querySelector<HTMLElement>("#roadmapNote");
        const candidateExperiences = document.querySelector<HTMLElement>("#candidateExperiences");
        const addCandidateExperience = document.querySelector<HTMLButtonElement>("#addCandidateExperience");
        const candidateSchools = document.querySelector<HTMLTextAreaElement>("#candidateSchools");
        const candidateProfileStatus = document.querySelector<HTMLElement>("#candidateProfileStatus");
        const exportCandidateProfile = document.querySelector<HTMLButtonElement>("#exportCandidateProfile");
        const candidateProfileDeleteBtn = document.querySelector<HTMLButtonElement>("#deleteCandidateProfile");
        const candidateMatchPanel = document.querySelector<HTMLElement>("#candidateMatchPanel");
        const candidateMatchScore = document.querySelector<HTMLElement>("#candidateMatchScore");
        const candidateMatchSummary = document.querySelector<HTMLElement>("#candidateMatchSummary");
        const candidateMatchSkills = document.querySelector<HTMLUListElement>("#candidateMatchSkills");
        const isFrench = document.documentElement.lang === "fr";
        const lang = (isFrench ? "fr" : "en") as Lang;
        const dynamicDrillStorageKey = `DRILLS_DYNAMIC_JOB_DATA_${document.documentElement.lang.toUpperCase()}`;
        const provenanceStorageKey = `DRILLS_DYNAMIC_JOB_PROVENANCE_${document.documentElement.lang.toUpperCase()}`;
        const copy = {
            missingPosting: isFrench ? "Colle l'annonce complète pour continuer." : "Paste the complete job posting to continue.",
            shortPosting: isFrench ? "Ajoute les missions et compétences requises pour obtenir une analyse utile." : "Add the role responsibilities and required skills for a useful analysis.",
            unsupportedPosting: isFrench
                ? "Je ne trouve pas de compétences IA/agents et techniques dans ce texte. Colle l'annonce complète avec l'intitulé du poste, les missions et les compétences requises — pas seulement les avantages ou la localisation."
                : "I couldn't find AI/agent and technical requirements in this text. Paste the full posting, including the role title, responsibilities, and required skills—not just benefits or location.",
            connecting: isFrench ? "Analyse de l'annonce et préparation du parcours…" : "Analyzing the posting and preparing your roadmap…",
            sending: isFrench ? "Création du parcours et de l'exercice Python ciblé…" : "Creating the roadmap and tailored Python drill…",
            ready: isFrench ? "Parcours prêt. Consulte les compétences et les étapes ci-dessous, puis lance l'exercice ciblé." : "Roadmap ready. Review the skills and steps below, then launch the tailored drill.",
            unavailable: isFrench ? "Le service de préparation est momentanément indisponible. Réessaie plus tard." : "Job preparation is temporarily unavailable. Please try again later.",
            failed: isFrench ? "La préparation a échoué. Vérifie ta connexion puis réessaie." : "Preparation failed. Check your connection and try again.",
            rateLimited: isFrench ? "Trop de demandes rapprochées. Attends un instant puis réessaie." : "Too many requests in a short time. Wait a moment, then try again.",
            invalidResponse: isFrench ? "La réponse reçue n'a pas pu être vérifiée. Réessaie." : "The response could not be validated. Please try again.",
            missingExperience: isFrench ? "Décris au moins une expérience ou un projet (20 caractères minimum) pour comparer les critères." : "Describe at least one experience or project (20 characters minimum) to compare the requirements.",
            profileSaved: isFrench ? "Profil enregistré dans ce navigateur pour 30 jours. Les informations du profil ne sont pas envoyées à l’IA." : "Profile saved in this browser for 30 days. Profile details are not sent to AI.",
            profileSaveFailed: isFrench ? "L’analyse est prête, mais le profil n’a pas pu être enregistré dans ce navigateur." : "The analysis is ready, but the profile could not be saved in this browser.",
            profileDeleted: isFrench ? "Profil supprimé de ce navigateur." : "Profile deleted from this browser.",
            profileExported: isFrench ? "Export du profil téléchargé." : "Profile export downloaded.",
            matched: isFrench ? "Correspondance dans" : "Text match in",
            partial: isFrench ? "Élément partiel" : "Partial evidence",
            notFound: isFrench ? "Non retrouvé dans le texte" : "Not found in the text",
            highMatch: isFrench ? "Au moins 60 % des critères pondérés apparaissent dans les expériences décrites. Tu peux poursuivre la préparation de cette candidature." : "At least 60% of weighted requirements appear in the experience you described. You can continue preparing this application.",
            lowMatch: isFrench ? "Moins de 60 % des critères pondérés apparaissent dans les expériences décrites. Examine les éléments non retrouvés : cela ne signifie pas que tu ne possèdes pas ces compétences." : "Fewer than 60% of weighted requirements appear in the experience you described. Review the items not found; this does not mean you lack those skills.",
        };

        function updateExperienceControls(): void {
            if (!candidateExperiences || !addCandidateExperience) return;
            addCandidateExperience.hidden = candidateExperiences.childElementCount >= 3;
            candidateExperiences.querySelectorAll<HTMLButtonElement>("[data-remove-experience]").forEach((button) => {
                button.hidden = candidateExperiences.childElementCount === 1;
            });
        }

        function appendExperienceFields(experience?: CandidateProfileInput["experiences"][number]): void {
            if (!candidateExperiences || candidateExperiences.childElementCount >= 3) return;
            const index = candidateExperiences.childElementCount + 1;
            const fieldset = document.createElement("fieldset");
            fieldset.className = "candidate-experience";
            fieldset.dataset.candidateExperience = "";
            const legend = document.createElement("legend");
            legend.textContent = `${isFrench ? "Expérience" : "Experience"} ${index}`;
            fieldset.append(legend);

            const addField = (key: "role" | "company" | "period" | "summary", labelText: string, tag: "input" | "textarea", value: string, placeholder = ""): void => {
                const label = document.createElement("label");
                label.textContent = labelText;
                const control = tag === "textarea" ? document.createElement("textarea") : document.createElement("input");
                control.dataset.experienceField = key;
                control.value = value;
                if (tag === "input") control.type = "text";
                if (key === "role" || key === "company") control.maxLength = 120;
                if (key === "period") control.maxLength = 80;
                if (key === "summary") {
                    control.maxLength = 2_000;
                    control.minLength = 20;
                    control.rows = 4;
                }
                if (placeholder) control.placeholder = placeholder;
                label.append(control);
                fieldset.append(label);
            };

            addField("role", isFrench ? "Intitulé du poste ou du projet" : "Role or project title", "input", experience?.role ?? "", isFrench ? "Ex. Analyste, développeuse web, cheffe de projet" : "e.g. Analyst, web developer, project manager");
            addField("company", isFrench ? "Nom de l’entreprise (facultatif)" : "Company name (optional)", "input", experience?.company ?? "");
            addField("period", isFrench ? "Période (facultatif)" : "Period (optional)", "input", experience?.period ?? "", isFrench ? "Ex. 2022–2025" : "e.g. 2022–2025");
            addField("summary", isFrench ? "Ce que tu as réellement fait" : "What you actually did", "textarea", experience?.summary ?? "", isFrench ? "Décris les tâches, projets, outils ou responsabilités pertinents. 20 caractères minimum." : "Describe relevant tasks, projects, tools, or responsibilities. At least 20 characters.");

            const remove = document.createElement("button");
            remove.type = "button";
            remove.className = "remove-experience";
            remove.dataset.removeExperience = "";
            remove.textContent = isFrench ? "Supprimer cette expérience" : "Remove this experience";
            remove.addEventListener("click", () => {
                fieldset.remove();
                if (!candidateExperiences.childElementCount) appendExperienceFields();
                updateExperienceControls();
            });
            fieldset.append(remove);
            candidateExperiences.append(fieldset);
            updateExperienceControls();
        }

        function candidateProfileInput(): CandidateProfileInput | null {
            const experiences = Array.from(candidateExperiences?.querySelectorAll<HTMLElement>("[data-candidate-experience]") ?? [])
                .map((card) => ({
                    role: card.querySelector<HTMLInputElement>('[data-experience-field="role"]')?.value ?? "",
                    company: card.querySelector<HTMLInputElement>('[data-experience-field="company"]')?.value ?? "",
                    period: card.querySelector<HTMLInputElement>('[data-experience-field="period"]')?.value ?? "",
                    summary: card.querySelector<HTMLTextAreaElement>('[data-experience-field="summary"]')?.value ?? "",
                }))
                .filter((item) => Object.values(item).some((value) => value.trim().length > 0));
            const result = CandidateProfileInputSchema.safeParse({
                experiences,
                schools: (candidateSchools?.value ?? "").split("\n").map((school) => school.trim()).filter(Boolean).slice(0, 5),
            });
            return result.success ? result.data : null;
        }

        function fillCandidateProfile(): void {
            const profile = readCandidateProfile();
            if (!profile) return;
            candidateExperiences?.replaceChildren();
            profile.experiences.forEach(appendExperienceFields);
            if (!profile.experiences.length) appendExperienceFields();
            if (candidateSchools) candidateSchools.value = profile.schools.join("\n");
            if (candidateProfileStatus) candidateProfileStatus.textContent = `${copy.profileSaved} (${new Intl.DateTimeFormat(isFrench ? "fr-FR" : "en-GB", { dateStyle: "medium" }).format(new Date(profile.expiresAt))})`;
            if (exportCandidateProfile) exportCandidateProfile.hidden = false;
            if (candidateProfileDeleteBtn) candidateProfileDeleteBtn.hidden = false;
        }

        function renderCandidateMatch(result: CandidateMatchResult): void {
            if (!candidateMatchPanel || !candidateMatchScore || !candidateMatchSummary || !candidateMatchSkills) return;
            candidateMatchScore.textContent = String(result.score);
            candidateMatchSummary.textContent = result.score >= 60 ? copy.highMatch : copy.lowMatch;
            candidateMatchSkills.replaceChildren(...result.skills.map((skill) => {
                const item = document.createElement("li");
                const label = document.createElement("strong");
                label.textContent = skill.name;
                const status = document.createElement("small");
                status.className = `match-${skill.status}`;
                status.textContent = skill.status === "matched"
                    ? `${copy.matched}: ${skill.evidenceSource ?? (isFrench ? "expérience décrite" : "described experience")}`
                    : skill.status === "partial" ? copy.partial : copy.notFound;
                item.append(label, status);
                return item;
            }));
            candidateMatchPanel.hidden = false;
        }

        function readAssessmentSnapshot(): unknown {
            try { return JSON.parse(localStorage.getItem(ASSESSMENT_KEY) ?? "null"); } catch { return null; }
        }

        function renderRoadmap(drill: DynamicDrill, provenance: RecommendationProvenance, snapshot: unknown = null, match: CandidateMatchResult | null = null) {
            if (!roadmapPanel || !roadmapTitle || !roadmapSummary || !roadmapSkills || !roadmapSteps || !roadmapKicker || !roadmapSkillsTitle || !roadmapStepsTitle || !roadmapNote) return;
            const language = document.documentElement.lang;
            const sourceCopy = provenanceCopy(provenance, lang);
            roadmapKicker.textContent = sourceCopy.title;
            roadmapNote.textContent = sourceCopy.description;
            const unattributedLegacy = provenance.migration === "legacy-unattributed";
            roadmapTitle.textContent = unattributedLegacy
                ? (isFrench ? "Exercice enregistré" : "Saved exercise")
                : drill.role_title;
            roadmapSummary.textContent = unattributedLegacy
                ? (isFrench ? "Les détails de ce parcours ne sont pas disponibles pour cet ancien exercice." : "Roadmap details are unavailable for this older exercise.")
                : drill.role_summary;
            roadmapSkillsTitle.textContent = provenance.source === "job-posting"
                ? (isFrench ? "Compétences relevées dans l'annonce" : "Skills identified in the posting")
                : (isFrench ? "Repères observés au diagnostic" : "Diagnostic signals");
            const snapshotData = snapshot && typeof snapshot === "object" ? snapshot as { pillars?: unknown } : null;
            const pillarScores = provenance.source === "diagnostic" && snapshotData?.pillars && typeof snapshotData.pillars === "object"
                ? Object.entries(snapshotData.pillars as Record<string, unknown>).flatMap(([pillar, value]) => {
                    if (!(pillar in PILLARS[lang]) || !value || typeof value !== "object") return [];
                    const score = value as { correct?: unknown; total?: unknown };
                    if (typeof score.correct !== "number" || typeof score.total !== "number") return [];
                    return [{ name: PILLARS[lang][pillar as SkillPillar], correct: score.correct, total: score.total }];
                })
                : [];
            const skillItems = provenance.source === "job-posting"
                ? drill.required_skills.map((skill) => ({ name: skill.name, priority: skill.priority, evidence: skill.evidence }))
                : pillarScores.map((score) => ({ name: score.name, priority: null, evidence: isFrench ? `${score.correct}/${score.total} réponses correctes` : `${score.correct}/${score.total} correct answers` }));
            roadmapSkills.hidden = unattributedLegacy || (provenance.source !== "job-posting" && skillItems.length === 0);
            roadmapSkillsTitle.hidden = roadmapSkills.hidden;
            roadmapSkills.replaceChildren(...skillItems.map((skill) => {
                const item = document.createElement("li");
                const name = document.createElement("strong");
                name.textContent = skill.name;
                const evidence = document.createElement("small");
                evidence.textContent = skill.evidence;
                if (skill.priority) {
                    const priority = document.createElement("span");
                    priority.className = `roadmap-priority roadmap-priority-${skill.priority.toLowerCase()}`;
                    priority.textContent = language === "fr"
                        ? ({ Core: "Essentielle", Important: "Importante", Supporting: "Complémentaire" } as const)[skill.priority]
                        : skill.priority;
                    item.append(name, priority, evidence);
                } else item.append(name, evidence);
                return item;
            }));
            roadmapSteps.hidden = unattributedLegacy;
            roadmapStepsTitle.hidden = unattributedLegacy;
            roadmapSteps.replaceChildren(...(unattributedLegacy ? [] : drill.roadmap.map((step, index) => {
                const item = document.createElement("li");
                const title = document.createElement("strong");
                title.textContent = step.title;
                const detail = document.createElement("small");
                detail.textContent = `${step.skill} · ${step.objective} · ${step.minutes} min`;
                item.append(title, detail);
                item.value = index + 1;
                return item;
            })));
            roadmapPanel.hidden = false;
            if (match) renderCandidateMatch(match);
        }

        function isSupportedPosting(text: string): boolean {
            const aiAgentSignal = /\b(?:ai|ia|llm|rag|langchain|langgraph|mcp|openai|anthropic|gemini)\b|intelligence artificielle|artificial intelligence|agents?\s+(?:ia|ai|conversationnels?|autonomes?|intelligents?)/i;
            const technicalSignal = /\b(?:python|fastapi|django|flask|api|backend|software|programming|programmer|code|engineering|developer|engineer)\b|développ(?:ement|eur|euse)|programmation|ingénieur|ingénierie|logiciel(?:s)?|développement logiciel/i;
            return aiAgentSignal.test(text) && technicalSignal.test(text);
        }

        function setStatus(message: string, state: "busy" | "success" | "error") {
            if (!generatorStatus) return;
            generatorStatus.hidden = false;
            generatorStatus.dataset.state = state;
            generatorStatus.textContent = message;
        }

        launchDrill?.addEventListener("click", () => {
            const target = launchDrill.dataset.href;
            if (target) window.location.assign(target);
        });

        fillCandidateProfile();
        if (!candidateExperiences?.childElementCount) appendExperienceFields();
        addCandidateExperience?.addEventListener("click", () => appendExperienceFields());
        exportCandidateProfile?.addEventListener("click", () => {
            const profile = readCandidateProfile();
            if (!profile) return;
            const file = new Blob([JSON.stringify(profile, null, 2)], { type: "application/json" });
            const url = URL.createObjectURL(file);
            const link = document.createElement("a");
            link.href = url;
            link.download = "drills-candidate-profile.json";
            link.click();
            window.setTimeout(() => URL.revokeObjectURL(url), 0);
            if (candidateProfileStatus) candidateProfileStatus.textContent = copy.profileExported;
        });
        candidateProfileDeleteBtn?.addEventListener("click", () => {
            removeCandidateProfile();
            candidateExperiences?.replaceChildren();
            appendExperienceFields();
            if (candidateSchools) candidateSchools.value = "";
            if (exportCandidateProfile) exportCandidateProfile.hidden = true;
            if (candidateProfileDeleteBtn) candidateProfileDeleteBtn.hidden = true;
            if (candidateMatchPanel) candidateMatchPanel.hidden = true;
            if (candidateProfileStatus) candidateProfileStatus.textContent = copy.profileDeleted;
        });

        // Restore the generated roadmap when returning from its drill.
        try {
            const cached: unknown = JSON.parse(localStorage.getItem(dynamicDrillStorageKey) ?? "null");
            const previous = StoredDynamicDrillSchema.safeParse(cached);
            if (previous.success) {
                const snapshot = readAssessmentSnapshot();
                const savedProvenance: unknown = JSON.parse(localStorage.getItem(provenanceStorageKey) ?? "null");
                const provenance = resolveStoredProvenance(savedProvenance, previous.data.drill_id, snapshot, readLearnerProfile() !== null);
                const candidateProfile = readCandidateProfile();
                const match = candidateProfile ? matchCandidateToDrill(candidateProfile, previous.data) : null;
                renderRoadmap(previous.data, provenance, snapshot, match);
            }
        } catch {
            // A malformed or unavailable saved payload should not block a new generation.
        }

        // Core Generation Pipeline
        generateBtn?.addEventListener("click", async () => {
            if (generateBtn.disabled) return;
            const jobDesc = jobDescriptionInput?.value.trim() ?? "";
            if (!jobDesc) {
                setStatus(copy.missingPosting, "error");
                jobDescriptionInput?.focus();
                return;
            }
            if (jobDesc.length < 50) {
                setStatus(copy.shortPosting, "error");
                jobDescriptionInput?.focus();
                return;
            }
            if (!isSupportedPosting(jobDesc)) {
                setStatus(copy.unsupportedPosting, "error");
                return;
            }
            const profileInput = candidateProfileInput();
            if (!profileInput) {
                setStatus(copy.missingExperience, "error");
                candidateExperiences?.querySelector<HTMLTextAreaElement>("[data-experience-field='summary']")?.focus();
                return;
            }
            const candidateProfile = createCandidateProfile(profileInput);
            if (!candidateProfile) {
                setStatus(copy.missingExperience, "error");
                return;
            }
            if (!drillsEndpoint) {
                setStatus(copy.unavailable, "error");
                return;
            }

            if (roadmapPanel) roadmapPanel.hidden = true;
            if (candidateMatchPanel) candidateMatchPanel.hidden = true;
            generateBtn.disabled = true;
            setStatus(copy.connecting, "busy");

            try {
                setStatus(copy.sending, "busy");

                const controller = new AbortController();
                const timeout = window.setTimeout(() => controller.abort(), 120_000);
                let response: Response;
                try {
                    response = await fetch(drillsEndpoint, {
                        method: "POST",
                        headers: { "Content-Type": "application/json", Accept: "application/json" },
                        body: JSON.stringify({
                            job_description: jobDesc,
                            output_language: isFrench ? "fr" : "en",
                            learner_snapshot: null,
                        }),
                        signal: controller.signal,
                    });
                } finally {
                    window.clearTimeout(timeout);
                }
                if (response.status === 429) throw new Error("rate-limited");
                if (!response.ok) throw new Error("request-failed");
                const generatedPayload: unknown = await response.json().catch(() => null);

                const validation = DynamicDrillSchema.safeParse(generatedPayload);
                if (!validation.success) throw new Error("invalid-response");
                const structuralDrillJson = validation.data;
                const persistedCandidateProfile = writeCandidateProfile(profileInput);
                const savedCandidateProfile = persistedCandidateProfile ?? candidateProfile;
                if (candidateProfileStatus) candidateProfileStatus.textContent = persistedCandidateProfile ? copy.profileSaved : copy.profileSaveFailed;
                if (exportCandidateProfile) exportCandidateProfile.hidden = false;
                if (candidateProfileDeleteBtn) candidateProfileDeleteBtn.hidden = false;
                const snapshot = readAssessmentSnapshot();
                const hasDiagnostic = !!snapshot && typeof snapshot === "object" && Array.isArray((snapshot as { answers?: unknown }).answers) && (snapshot as { answers: unknown[] }).answers.length > 0;
                const provenance = createRecommendationProvenance({ diagnostic: hasDiagnostic, profile: readLearnerProfile() !== null, analyzedPosting: true });
                localStorage.removeItem(provenanceStorageKey);
                localStorage.setItem(dynamicDrillStorageKey, JSON.stringify(structuralDrillJson));
                localStorage.setItem(provenanceStorageKey, JSON.stringify(createStoredRecommendationPlan(structuralDrillJson.drill_id, provenance)));
                renderRoadmap(structuralDrillJson, provenance, snapshot, matchCandidateToDrill(savedCandidateProfile, structuralDrillJson));
                roadmapTitle?.focus({ preventScroll: true });
                roadmapPanel?.scrollIntoView({ behavior: "smooth", block: "start" });
                setStatus(copy.ready, "success");
            } catch (err: unknown) {
                const message = err instanceof Error && err.message === "rate-limited"
                    ? copy.rateLimited
                    : err instanceof Error && err.message === "invalid-response"
                      ? copy.invalidResponse
                      : copy.failed;
                setStatus(message, "error");
            } finally {
                generateBtn.disabled = false;
            }
        });
    </script>
  </section>
</App>
