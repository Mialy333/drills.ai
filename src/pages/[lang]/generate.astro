---
import App from "../../layouts/App.astro";
import { href, LANGS, type Lang } from "../../lib/drills";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<App lang={lang} title={lang === "fr" ? "Générateur de drills" : "Drill generator"} path="/generate/" section="generate">
  <section class="generator-page" aria-labelledby="generator-title">
    <header class="generator-head">
      <p class="generator-kicker">{lang === "fr" ? "PROTOCOLE // GÉNÉRATEUR" : "PROTOCOL // GENERATOR"}</p>
      <h1 id="generator-title">{lang === "fr" ? "Générateur de drills dynamiques" : "Dynamic drill generator"}</h1>
      <p>{lang === "fr" ? "Collez une annonce complète pour obtenir son analyse de compétences, un plan de préparation et un exercice Python ciblé." : "Paste a complete job posting to get its skill analysis, preparation roadmap, and a tailored Python exercise."}</p>
      <p>{lang === "fr" ? "Cette version cible les postes d’AI Agent Engineer. L’annonce doit mentionner l’IA ou les agents, ainsi que des compétences techniques." : "This version targets AI Agent Engineer roles. The posting must mention AI or agents, plus technical skills."}</p>
      <p>{lang === "fr" ? "Le parcours et l’exercice suivent la langue de l’interface. Une annonce rédigée dans une autre langue sera analysée sans changer la langue des résultats." : "The roadmap and exercise follow the interface language. A posting written in another language will be analysed without changing the language of the results."}</p>
    </header>
    <style>
        .generator-page { max-width: 860px; margin: 0 auto; }
        .generator-head { margin-bottom: 28px; }
        .generator-head h1 { color: var(--ink); text-shadow: 0 0 18px color-mix(in srgb, var(--accent) 55%, transparent); }
        .generator-head > p:last-child { color: var(--muted); }
        .generator-kicker { color: var(--ok); font: 1rem var(--pixel); letter-spacing: .08em; }
        .generator-card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-m); padding: 24px; margin-bottom: 20px; box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 10%, transparent); }
        label { display: block; font-weight: bold; margin-bottom: 8px; font-family: var(--mono); color: var(--muted); }
        .generator-card textarea {
            width: 100%;
            background: var(--code-bg);
            border: 1px solid var(--line);
            border-radius: 6px;
            color: var(--ink);
            padding: 10px;
            box-sizing: border-box;
            margin-bottom: 15px;
        }
        .generator-card textarea { font-family: var(--mono); height: 180px; }
        .generator-card button {
            background: var(--accent);
            color: var(--accent-ink);
            border: 1px solid var(--accent);
            border-radius: 6px;
            padding: 12px 20px;
            font-weight: bold;
            cursor: pointer;
            font-family: monospace;
            width: 100%;
        }
        .generator-card button:hover { filter: brightness(1.1); }
        .generator-help { margin: 0 0 14px; color: var(--muted); font-size: .9rem; }
        .roadmap-panel { padding: 24px; border: 1px solid var(--ok); border-radius: var(--radius-m); background: var(--panel); margin-bottom: 20px; box-shadow: 0 0 24px color-mix(in srgb, var(--ok) 10%, transparent); }
        .roadmap-panel[hidden] { display: none; }
        .roadmap-panel h2 { margin: 0 0 8px; }
        .roadmap-summary { color: var(--muted); }
        .roadmap-note { color: var(--muted); font-size: .9rem; }
        .roadmap-skills, .roadmap-steps { display: grid; gap: 12px; padding-left: 24px; }
        :global(.roadmap-skills li) { padding-left: 4px; }
        :global(.roadmap-steps li) { padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--radius-s); background: var(--raise); line-height: 1.45; }
        :global(.roadmap-steps li > strong) { display: block; line-height: 1.35; }
        :global(.roadmap-skills li) { display: grid; grid-template-columns: minmax(0, 1fr) max-content; align-items: center; gap: 6px 12px; }
        :global(.roadmap-skills small), :global(.roadmap-steps small) { display: block; color: var(--muted); margin-top: 3px; }
        :global(.roadmap-skills small) { grid-column: 1 / -1; margin: 4px 0 0; padding-top: 8px; border-top: 1px solid var(--line); line-height: 1.5; }
        :global(.roadmap-steps small) { margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--line); line-height: 1.55; }
        :global(.roadmap-priority) { display: inline-block; padding: 3px 9px; border: 1px solid currentColor; border-radius: 999px; font: .82rem var(--pixel); white-space: nowrap; }
        :global(.roadmap-priority-core) { color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
        :global(.roadmap-priority-important) { color: var(--warn); background: color-mix(in srgb, var(--warn) 12%, transparent); }
        :global(.roadmap-priority-supporting) { color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, transparent); }
        #launchDrill { margin-top: 20px; background: var(--code-bg); border-color: var(--ok); color: var(--ok); box-shadow: 0 0 14px color-mix(in srgb, var(--ok) 24%, transparent); }
        .generator-status { margin: 16px 0 20px; padding: 14px 16px; border: 1px solid var(--line); border-radius: var(--radius-s); background: var(--panel); }
        .generator-status[hidden] { display: none; }
        .generator-status[data-state="busy"] { border-color: var(--accent); }
        .generator-status[data-state="success"] { border-color: var(--ok); color: var(--ok); }
        .generator-status[data-state="error"] { border-color: var(--warn); color: var(--warn); }
    </style>

    <div class="generator-card">
        <label for="jobDescription">{lang === "fr" ? "> COLLE L'ANNONCE COMPLÈTE" : "> PASTE THE FULL JOB POSTING"}</label>
        <textarea id="jobDescription" placeholder={lang === "fr" ? "Colle les missions et compétences requises, pas seulement les avantages ou la localisation." : "Include responsibilities and required skills, not only benefits or location."}></textarea>
        
        <button id="generateBtn" type="button">{lang === "fr" ? "⚡ ANALYSER L'ANNONCE ET CRÉER MON PARCOURS" : "⚡ ANALYZE POSTING AND BUILD MY ROADMAP"}</button>
        <div id="generatorStatus" class="generator-status" role="status" aria-live="polite" hidden></div>
    </div>

    <section class="roadmap-panel" id="roadmapPanel" hidden aria-live="polite" aria-labelledby="roadmapTitle">
        <p class="generator-kicker">{lang === "fr" ? "PLAN DE PRÉPARATION // FONDÉ SUR L'ANNONCE" : "PREPARATION ROADMAP // GROUNDED IN THE POSTING"}</p>
        <h2 id="roadmapTitle" tabindex="-1"></h2>
        <p class="roadmap-summary" id="roadmapSummary"></p>
        <h3>{lang === "fr" ? "Compétences demandées" : "Skills requested"}</h3>
        <ul class="roadmap-skills" id="roadmapSkills"></ul>
        <h3>{lang === "fr" ? "Étapes de préparation" : "Preparation steps"}</h3>
        <ol class="roadmap-steps" id="roadmapSteps"></ol>
        <p class="roadmap-note">{lang === "fr" ? "Les priorités tiennent compte du diagnostic s'il a été effectué. Sans diagnostic, ce plan reflète uniquement les exigences de l'annonce." : "Priorities use your diagnostic if available. Without one, this plan reflects the job posting only."}</p>
        <button id="launchDrill" class="btn btn-primary btn-big" type="button" data-href={href(`/${lang}/python/dynamic-job/`)}>
          {lang === "fr" ? "▶ LANCER L'EXERCICE CIBLÉ" : "▶ LAUNCH THE TAILORED DRILL"}
        </button>
    </section>

    <script>
        import { DynamicDrillSchema, type DynamicDrill } from "../../lib/contracts";
        import { apiEndpoint } from "../../lib/api-client";
        import { profileSnapshot, readLearnerProfile, ASSESSMENT_KEY } from "../../lib/learner";

        // UI Element Selectors
        const jobDescriptionInput = document.querySelector<HTMLTextAreaElement>("#jobDescription");
        const generateBtn = document.querySelector<HTMLButtonElement>("#generateBtn");
        const drillsEndpoint = apiEndpoint("/api/drills");
        const launchDrill = document.querySelector<HTMLButtonElement>("#launchDrill");
        const generatorStatus = document.querySelector<HTMLDivElement>("#generatorStatus");
        const roadmapPanel = document.querySelector<HTMLElement>("#roadmapPanel");
        const roadmapTitle = document.querySelector<HTMLElement>("#roadmapTitle");
        const roadmapSummary = document.querySelector<HTMLElement>("#roadmapSummary");
        const roadmapSkills = document.querySelector<HTMLUListElement>("#roadmapSkills");
        const roadmapSteps = document.querySelector<HTMLOListElement>("#roadmapSteps");
        const isFrench = document.documentElement.lang === "fr";
        const dynamicDrillStorageKey = `DRILLS_DYNAMIC_JOB_DATA_${document.documentElement.lang.toUpperCase()}`;
        const copy = {
            missingPosting: isFrench ? "Colle l'annonce complète pour continuer." : "Paste the complete job posting to continue.",
            shortPosting: isFrench ? "Ajoute les missions et compétences requises pour obtenir une analyse utile." : "Add the role responsibilities and required skills for a useful analysis.",
            unsupportedPosting: isFrench
                ? "Je ne trouve pas de compétences IA/agents et techniques dans ce texte. Colle l'annonce complète avec l'intitulé du poste, les missions et les compétences requises — pas seulement les avantages ou la localisation."
                : "I couldn't find AI/agent and technical requirements in this text. Paste the full posting, including the role title, responsibilities, and required skills—not just benefits or location.",
            connecting: isFrench ? "Analyse de l'annonce et préparation du parcours…" : "Analyzing the posting and preparing your roadmap…",
            sending: isFrench ? "Création du parcours et de l'exercice Python ciblé…" : "Creating the roadmap and tailored Python drill…",
            ready: isFrench ? "Parcours prêt. Consulte les compétences et les étapes ci-dessous, puis lance l'exercice ciblé." : "Roadmap ready. Review the skills and steps below, then launch the tailored drill.",
            unavailable: isFrench ? "Le service de préparation est momentanément indisponible. Réessaie plus tard." : "Job preparation is temporarily unavailable. Please try again later.",
            failed: isFrench ? "La préparation a échoué. Vérifie ta connexion puis réessaie." : "Preparation failed. Check your connection and try again.",
            rateLimited: isFrench ? "Trop de demandes rapprochées. Attends un instant puis réessaie." : "Too many requests in a short time. Wait a moment, then try again.",
            invalidResponse: isFrench ? "La réponse reçue n'a pas pu être vérifiée. Réessaie." : "The response could not be validated. Please try again.",
        };

        function renderRoadmap(drill: DynamicDrill) {
            if (!roadmapPanel || !roadmapTitle || !roadmapSummary || !roadmapSkills || !roadmapSteps) return;
            const language = document.documentElement.lang;
            roadmapTitle.textContent = drill.role_title;
            roadmapSummary.textContent = drill.role_summary;
            roadmapSkills.replaceChildren(...drill.required_skills.map((skill) => {
                const item = document.createElement("li");
                const name = document.createElement("strong");
                name.textContent = skill.name;
                const priority = document.createElement("span");
                priority.className = `roadmap-priority roadmap-priority-${skill.priority.toLowerCase()}`;
                priority.textContent = language === "fr"
                    ? ({ Core: "Essentielle", Important: "Importante", Supporting: "Complémentaire" } as const)[skill.priority]
                    : skill.priority;
                const evidence = document.createElement("small");
                evidence.textContent = skill.evidence;
                item.append(name, priority, evidence);
                return item;
            }));
            roadmapSteps.replaceChildren(...drill.roadmap.map((step, index) => {
                const item = document.createElement("li");
                const title = document.createElement("strong");
                title.textContent = step.title;
                const detail = document.createElement("small");
                detail.textContent = `${step.skill} · ${step.objective} · ${step.minutes} min`;
                item.append(title, detail);
                item.value = index + 1;
                return item;
            }));
            roadmapPanel.hidden = false;
        }

        function isSupportedPosting(text: string): boolean {
            const aiAgentSignal = /\b(?:ai|ia|llm|rag|langchain|langgraph|mcp|openai|anthropic|gemini)\b|intelligence artificielle|artificial intelligence|agents?\s+(?:ia|ai|conversationnels?|autonomes?|intelligents?)/i;
            const technicalSignal = /\b(?:python|fastapi|django|flask|api|backend|software|programming|programmer|code|engineering|developer|engineer)\b|développ(?:ement|eur|euse)|programmation|ingénieur|ingénierie|logiciel(?:s)?|développement logiciel/i;
            return aiAgentSignal.test(text) && technicalSignal.test(text);
        }

        function setStatus(message: string, state: "busy" | "success" | "error") {
            if (!generatorStatus) return;
            generatorStatus.hidden = false;
            generatorStatus.dataset.state = state;
            generatorStatus.textContent = message;
        }

        launchDrill?.addEventListener("click", () => {
            const target = launchDrill.dataset.href;
            if (target) window.location.assign(target);
        });

        // Restore the generated roadmap when returning from its drill.
        try {
            const cached: unknown = JSON.parse(localStorage.getItem(dynamicDrillStorageKey) ?? "null");
            const previous = DynamicDrillSchema.safeParse(cached);
            if (previous.success) renderRoadmap(previous.data);
        } catch {
            // A malformed or unavailable saved payload should not block a new generation.
        }

        // Core Generation Pipeline
        generateBtn?.addEventListener("click", async () => {
            if (generateBtn.disabled) return;
            const jobDesc = jobDescriptionInput?.value.trim() ?? "";
            if (!jobDesc) {
                setStatus(copy.missingPosting, "error");
                jobDescriptionInput?.focus();
                return;
            }
            if (jobDesc.length < 50) {
                setStatus(copy.shortPosting, "error");
                jobDescriptionInput?.focus();
                return;
            }
            if (!isSupportedPosting(jobDesc)) {
                setStatus(copy.unsupportedPosting, "error");
                return;
            }
            if (!drillsEndpoint) {
                setStatus(copy.unavailable, "error");
                return;
            }

            if (roadmapPanel) roadmapPanel.hidden = true;
            generateBtn.disabled = true;
            setStatus(copy.connecting, "busy");

            try {
                setStatus(copy.sending, "busy");

                let learnerContext = "";
                try {
                    const profile = readLearnerProfile();
                    if (profile) learnerContext = profileSnapshot(profile, isFrench ? "fr" : "en");
                    const snapshot: unknown = JSON.parse(localStorage.getItem(ASSESSMENT_KEY) ?? "null");
                    if (snapshot && typeof snapshot === "object" && "pillars" in snapshot && snapshot.pillars && typeof snapshot.pillars === "object") {
                        const pillars = snapshot.pillars as Record<string, unknown>;
                        const scores = Object.entries(pillars).flatMap(([pillar, score]) => {
                            if (!score || typeof score !== "object" || !("correct" in score) || !("total" in score)) return [];
                            const { correct, total } = score as { correct: unknown; total: unknown };
                            return typeof correct === "number" && typeof total === "number" ? [`${pillar}: ${correct}/${total} quiz answers correct`] : [];
                        });
                        if (scores.length) {
                            const demonstrated = isFrench
                                ? `Résultat du quiz (compétences démontrées uniquement par ces questions) : ${scores.join(" ; ")}.`
                                : `Quiz result (demonstrated only on these questions): ${scores.join("; ")}.`;
                            learnerContext = [learnerContext, demonstrated].filter(Boolean).join(" ");
                        }
                    }
                } catch {
                    // The job-based roadmap can still be generated without a saved diagnostic.
                }

                const controller = new AbortController();
                const timeout = window.setTimeout(() => controller.abort(), 120_000);
                let response: Response;
                try {
                    response = await fetch(drillsEndpoint, {
                        method: "POST",
                        headers: { "Content-Type": "application/json", Accept: "application/json" },
                        body: JSON.stringify({
                            job_description: jobDesc,
                            output_language: isFrench ? "fr" : "en",
                            learner_snapshot: learnerContext || null,
                        }),
                        signal: controller.signal,
                    });
                } finally {
                    window.clearTimeout(timeout);
                }
                if (response.status === 429) throw new Error("rate-limited");
                if (!response.ok) throw new Error("request-failed");
                const generatedPayload: unknown = await response.json().catch(() => null);

                const validation = DynamicDrillSchema.safeParse(generatedPayload);
                if (!validation.success) throw new Error("invalid-response");
                const structuralDrillJson = validation.data;
                localStorage.setItem(dynamicDrillStorageKey, JSON.stringify(structuralDrillJson));
                renderRoadmap(structuralDrillJson);
                roadmapTitle?.focus({ preventScroll: true });
                roadmapPanel?.scrollIntoView({ behavior: "smooth", block: "start" });
                setStatus(copy.ready, "success");
            } catch (err: unknown) {
                const message = err instanceof Error && err.message === "rate-limited"
                    ? copy.rateLimited
                    : err instanceof Error && err.message === "invalid-response"
                      ? copy.invalidResponse
                      : copy.failed;
                setStatus(message, "error");
            } finally {
                generateBtn.disabled = false;
            }
        });
    </script>
  </section>
</App>
