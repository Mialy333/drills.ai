---
import App from "../../layouts/App.astro";
import { LANGS, href, type Lang } from "../../lib/drills";
export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const fr = lang === "fr";
---

<App lang={lang} title={fr ? "Ma candidature" : "My application"} path="/apply/" section="apply">
  <section class="application-page" id="application-page">
    <header class="application-heading">
      <p class="application-eyebrow">{fr ? "TON PARCOURS → TA PROCHAINE OPPORTUNITÉ" : "YOUR EXPERIENCE → YOUR NEXT OPPORTUNITY"}</p>
      <h1 id="application-heading-title">{fr ? "Ta prochaine candidature commence ici." : "Your next application starts here."}</h1>
      <p>{fr ? "Fais le lien entre ton parcours et un premier poste d’Agent Engineer. Repars avec des preuves, des priorités et une candidature à personnaliser." : "Connect your experience to a first Agent Engineer role. Leave with evidence, priorities and an application to make your own."}</p>
      <nav class="application-steps" aria-label={fr ? "Étapes de candidature" : "Application steps"}>
        {[['profile',fr?'1 · Mon profil':'1 · My profile'],['posting',fr?'2 · Opportunités':'2 · Opportunities'],['diagnostic',fr?'3 · Diagnostic':'3 · Assessment'],['documents',fr?'4 · Mes documents':'4 · My documents']].map(([step,label])=><button type="button" class="btn btn-secondary" data-application-step={step}>{label}</button>)}
      </nav>
    </header>

    <form id="application-form" novalidate>
      <fieldset id="application-inputs" class="application-inputs">
        <legend class="sr-only">{fr ? "Préparer une candidature" : "Prepare an application"}</legend>
        <div class="application-grid">
          <section class="application-card" id="application-profile-card">
            <h2>{fr ? "01 · Ton parcours, avec tes mots" : "01 · Your experience, in your words"}</h2>
            <p>{fr ? "Importe ton CV : ton parcours sera rempli automatiquement. Tu peux aussi saisir un profil une fois, puis le réutiliser pour tes annonces." : "Import your CV to fill your experience automatically. You can also enter a profile once and reuse it for your postings."}</p>
            <div class="application-import">
              <h3>{fr ? "Importer mon CV PDF (4 Mio max.)" : "Import my PDF CV (4 MiB max.)"}</h3>
              <p>{fr ? "L’import remplace le profil actuel, sans ressaisie. Relis et corrige l’extraction avant l’analyse. Le fichier sera transmis à OpenAI après ton accord ci-dessous." : "Import replaces the current profile, without retyping. Review and correct the extraction before analysis. The file is sent to OpenAI after you agree below."}</p>
              <label for="application-pdf">{fr ? "CV au format PDF" : "PDF CV"}</label>
              <input id="application-pdf" class="sr-only" type="file" accept="application/pdf,.pdf" />
              <button type="button" class="btn btn-secondary" id="application-pick-pdf">{fr ? "Choisir mon CV PDF" : "Choose my PDF CV"}</button>
              <span id="application-file-name" role="status">{fr ? "Aucun fichier sélectionné" : "No file selected"}</span>
              <button type="button" class="btn btn-secondary" id="application-import">{fr ? "Extraire le texte du CV" : "Extract CV text"}</button>
            </div>
            <details class="application-import"><summary>{fr ? "Ajouter un projet GitHub public" : "Add a public GitHub project"}</summary>
              <p>{fr ? "Colle le lien d’un dépôt. Vérifie les informations et précise ta contribution avant de les ajouter à ton profil." : "Paste a repository URL. Review the information and describe your contribution before adding it to your profile."}</p>
              <label for="github-url">{fr ? "Lien du dépôt public" : "Public repository URL"}</label>
              <input id="github-url" type="text" placeholder="https://github.com/owner/project" />
              <button id="github-load" type="button" class="btn btn-secondary">{fr ? "Lire le projet GitHub" : "Read GitHub project"}</button>
              <p id="github-status" role="status"></p>
              <div id="github-review" hidden>
                <label for="github-preview">{fr ? "Informations à vérifier" : "Information to review"}</label><textarea id="github-preview" rows="6" maxlength="3000"></textarea>
                <label for="github-contribution">{fr ? "Ce que tu as personnellement réalisé" : "What you personally built"}</label><textarea id="github-contribution" rows="3" maxlength="2000"></textarea>
                <button id="github-add" type="button" class="btn btn-secondary">{fr ? "Ajouter à mon profil" : "Add to my profile"}</button>
              </div>
            </details>
            <details class="application-import"><summary>{fr ? "Lieu de résidence et droit de travailler" : "Residence and right to work"}</summary>
              <label for="application-residence">{fr ? "Lieu de résidence (facultatif)" : "Residence (optional)"}</label><input id="application-residence" type="text" maxlength="100" placeholder="Paris, France" />
              <label for="application-work-country">{fr ? "Pays concerné par ton droit de travailler" : "Country covered by your right to work"}</label><input id="application-work-country" type="text" maxlength="100" placeholder="France" />
              <label for="application-work-authorization">{fr ? "Ta situation déclarée" : "Your declared situation"}</label>
              <select id="application-work-authorization">
                <option value="unknown">{fr ? "À préciser / je ne sais pas" : "Not specified / unsure"}</option>
                <option value="yes">{fr ? "J’ai le droit d’y travailler sans parrainage de l’employeur" : "I have the right to work there without employer sponsorship"}</option>
                <option value="restricted">{fr ? "Mon droit de travailler comporte des restrictions" : "My right to work has restrictions"}</option>
                <option value="sponsorship">{fr ? "J’ai besoin d’une autorisation ou du parrainage de l’employeur" : "I need authorization or employer sponsorship"}</option>
              </select>
              <p>{fr ? "Ces informations seront prises en compte au prochain diagnostic. Une déclaration ne constitue pas une vérification administrative. La résidence seule ne permet pas de conclure au droit de travailler." : "These details will inform your next assessment. A declaration is not administrative verification. Residence alone does not establish a right to work."}</p>
            </details>
            <p id="application-profile-summary" role="status"></p>
            <details id="application-profile-editor"><summary>{fr ? "Écrire, consulter ou modifier mon profil" : "Write, view or edit my profile"}</summary>
            <label for="application-profile">{fr ? "Parcours et preuves" : "Experience and evidence"}</label>
            <textarea id="application-profile" maxlength="16000" rows="13" autocomplete="off" placeholder={fr ? "Expériences · contributions concrètes · projets · formations…" : "Experience · concrete contributions · projects · education…"}></textarea>
            </details>

          </section>
          <section class="application-card" id="application-posting-card">
            <h2>{fr ? "02 · L’opportunité que tu vises" : "02 · The opportunity you want"}</h2>
            <p>{fr ? "Stage, alternance ou premier emploi : colle l’annonce complète, avec les missions, compétences et conditions. Un lien seul ne suffit pas." : "Internship, apprenticeship or first job: paste the full posting, including duties, skills and conditions. A link alone is not enough."}</p>
            <p>{fr ? "Ton profil est repris automatiquement : aucune expérience à ressaisir ici." : "Your profile is reused automatically: no experience to enter again here."}</p>
            <p id="application-saved-profile" hidden>{fr ? "Ton profil enregistré sera utilisé." : "Your saved profile will be used."} <a href={href(`/${lang}/apply/?step=profile`)}>{fr ? "Consulter ou modifier mon profil" : "View or edit my profile"}</a></p>
            <div class="opportunity-tabs"><button type="button" class="btn btn-secondary" id="jobs-show-list">{fr ? "Chercher des offres" : "Browse openings"}</button><button type="button" class="btn btn-secondary" id="jobs-show-posting">{fr ? "Coller une annonce" : "Paste a posting"}</button></div>
            <section id="jobs-browser" hidden>
              <div class="jobs-search-row"><div><label for="jobs-location">{fr ? "Lieu" : "Location"}</label><input id="jobs-location" type="text" maxlength="100" placeholder="Paris" /></div>
              <button id="jobs-load" type="button" class="btn btn-secondary">{fr ? "Rechercher" : "Search"}</button></div>
              <p id="jobs-status" role="status"></p><div id="jobs-results"></div>
              <div class="application-actions" id="jobs-pagination" hidden><button type="button" id="jobs-previous" class="btn btn-secondary">{fr ? "Précédent" : "Previous"}</button><span id="jobs-page"></span><button type="button" id="jobs-next" class="btn btn-secondary">{fr ? "Suivant" : "Next"}</button></div>
            </section>
            <section id="jobs-posting-editor" hidden>
            <label for="application-posting-url">{fr ? "Lien de l’annonce ou du formulaire de candidature (facultatif)" : "Posting or application form URL (optional)"}</label>
            <input id="application-posting-url" type="url" maxlength="2000" placeholder="https://…" />
            <label for="application-posting">{fr ? "Texte de l’annonce" : "Job posting text"}</label>
            <textarea id="application-posting" required minlength="50" maxlength="20000" rows="7" autocomplete="off" placeholder={fr ? "Intitulé · missions · compétences · contrat · localisation…" : "Title · duties · skills · contract · location…"}></textarea>
            </section>
            <p class="application-note" id="jobs-explanation" hidden>{fr ? "Les conditions de candidature sont séparées des compétences. Le bilan ne prédit pas tes chances de recrutement." : "Application conditions are separate from skills. The assessment does not predict hiring chances."}</p>
          </section>
        </div>
        <div class="application-card application-consent" id="application-consent-panel">
          <label class="application-check"><input id="application-consent" type="checkbox" required />
            <span>{fr ? "J’accepte l’envoi des données saisies (et du PDF si je l’importe) au serveur DRILLS et à OpenAI pour cette préparation. Je retire les informations sensibles inutiles." : "I agree to send the entered data (and the PDF if imported) to the DRILLS server and OpenAI for this preparation. I remove unnecessary sensitive information."}</span>
          </label>
          <p class="application-note">{fr ? "Ton dossier est conservé dans cet onglet. Active l’option ci-dessous pour le retrouver sur cet appareil pendant 30 jours." : "Your application is kept in this tab. Enable the option below to remember it on this device for 30 days."}</p>
          <label class="application-check"><input id="application-remember" type="checkbox" /><span>{fr ? "Conserver mon dossier sur cet appareil pendant 30 jours (éviter sur un appareil partagé)." : "Keep my application on this device for 30 days (avoid on shared devices)."}</span></label>
          <p id="application-status" role="status" aria-live="polite">{fr ? "Commence par ton CV ou ton parcours, puis clique sur Suivant." : "Start with your CV or experience, then click Next."}</p>
          <div class="application-actions">
            <button class="btn btn-primary" type="submit" id="application-submit">{fr ? "Obtenir mon diagnostic" : "Get my assessment"}</button>
            <button class="btn btn-secondary" type="button" id="application-example">{fr ? "Remplir un exemple fictif" : "Fill a fictional example"}</button>
          </div>
        </div>
      </fieldset>
    </form>
    <div class="application-actions" id="application-reset-actions">
      <button type="button" class="btn btn-secondary" id="application-cancel" hidden>{fr ? "Annuler" : "Cancel"}</button>
      <details><summary>{fr ? "Gérer mon dossier" : "Manage my application"}</summary><button type="button" class="text-button" id="application-clear">{fr ? "Effacer mon dossier et son profil enregistré" : "Delete this application and its saved profile"}</button></details>
    </div>


    <section id="application-results" hidden aria-labelledby="application-result-title">
      <div class="application-card" id="application-diagnostic-panel">
        <p class="application-eyebrow">{fr ? "03 · TES PREUVES, TES PROCHAINES ÉTAPES" : "03 · YOUR EVIDENCE, YOUR NEXT STEPS"}</p>
        <h2 id="application-result-title" tabindex="-1"></h2>
        <p id="application-scope"></p>
        <p class="application-score" id="application-score"></p>
        <p id="application-eligibility" role="status"></p>
        <p id="application-decision"></p>
        <div id="application-evidence" class="application-evidence"></div>
        <button type="button" class="btn btn-primary" data-application-step="documents">{fr ? "Préparer mes documents →" : "Prepare my documents →"}</button>
      </div>
      <section class="application-card" id="application-documents-panel">
        <h2>{fr ? "Tes textes, à relire et à personnaliser" : "Your drafts, ready for your review"}</h2>
        <p>{fr ? "Relis les faits, les dates et les formulations avant d’envoyer ta candidature." : "Review facts, dates and wording before submitting your application."}</p>
        <p id="application-drafts-status" role="status" aria-live="polite"></p>
        <div id="application-drafts-controls" hidden>
          <p>{fr ? "Ton diagnostic est prêt. Le CV et la présentation sont rédigés à cette étape pour ne pas retarder ton bilan." : "Your assessment is ready. Your CV and introduction are drafted at this step so they do not delay your assessment."}</p>
          <label class="application-check"><input type="checkbox" id="application-drafts-consent" /><span>{fr ? "J’accepte l’envoi de mon profil et de cette annonce à OpenAI pour rédiger mes documents." : "I agree to send my profile and this posting to OpenAI to draft my documents."}</span></label>
          <button type="button" class="btn btn-primary" id="application-generate-documents">{fr ? "Rédiger mes documents" : "Draft my documents"}</button>
        </div>
        <div id="application-drafts-content">
        <details class="draft-editor" open><summary>{fr ? "Mon CV ciblé" : "My targeted CV"}</summary><p>{fr ? "Garde les contributions concrètes, les dates et les projets que tu peux expliquer. Ajuste les formulations pour qu’elles te ressemblent." : "Keep concrete contributions, dates and projects you can explain. Adjust the wording to sound like you."}</p>
        <label for="application-contact">{fr ? "Nom et coordonnées pour le CV (facultatif, reste dans ton navigateur)" : "Name and contact details for the CV (optional, stays in your browser)"}</label>
        <textarea id="application-contact" rows="2" maxlength="500" autocomplete="off"></textarea>
        <label for="application-cv">{fr ? "CV ciblé — texte modifiable" : "Targeted CV — editable text"}</label>
        <div id="cv-toolbar" class="cv-toolbar" role="group" aria-label={fr ? "Mise en forme du CV" : "CV formatting"}>
          <select id="cv-font" aria-label={fr ? "Police" : "Font"}>{['Arial','Georgia','Verdana','Times New Roman'].map(font=><option value={font}>{font}</option>)}</select>
          <select id="cv-size" aria-label={fr ? "Taille de police" : "Font size"}>{[8,9,10,11,12,14,16,18,20,24,28,32,36].map(size=><option value={`${size}pt`} selected={size===11}>{size}</option>)}</select>
          <input id="cv-color" type="color" value="#111111" aria-label={fr ? "Couleur du texte" : "Text color"} title={fr ? "Couleur du texte" : "Text color"} />
          {[['bold','B',fr?'Gras':'Bold'],['italic','I',fr?'Italique':'Italic'],['underline','U',fr?'Souligné':'Underline'],['strike','S',fr?'Barré':'Strikethrough'],['left','≡←',fr?'Aligner à gauche':'Align left'],['center','≡',fr?'Centrer':'Center'],['right','→≡',fr?'Aligner à droite':'Align right'],['justify','☰',fr?'Justifier':'Justify'],['bulletList','• ≡',fr?'Liste à puces':'Bullet list'],['orderedList','1. ≡',fr?'Liste numérotée':'Numbered list'],['undo','↶',fr?'Annuler':'Undo'],['redo','↷',fr?'Rétablir':'Redo'],['clear','Tx',fr?'Effacer la mise en forme':'Clear formatting']].map(([command,icon,label]) => <button type="button" data-command={command} aria-label={label} title={label}>{icon}</button>)}
          <select id="cv-line-height" aria-label={fr?'Interligne':'Line spacing'}>{['1','1.2','1.5','1.8','2'].map(value=><option value={value} selected={value==='1.5'}>↕ {value}</option>)}</select>
          <details class="cv-link-panel"><summary>{fr ? "Lien" : "Link"}</summary><div>
            <label for="cv-link-url">{fr ? "Adresse du lien" : "Link address"}</label><input id="cv-link-url" type="url" placeholder="https://…" />
            <button type="button" data-command="link">{fr ? "Appliquer / modifier" : "Apply / edit"}</button>
            <button type="button" data-command="unlink">{fr ? "Supprimer le lien" : "Remove link"}</button>
          </div></details>
        </div>
        <p id="cv-editor-note" role="status">{fr ? "Sélectionne le texte. Reclique sur un bouton actif pour retirer son effet. L’alignement concerne les paragraphes sélectionnés." : "Select text. Click an active button again to remove its effect. Alignment applies to selected paragraphs."}</p>
        <button id="cv-reformat" type="button" class="btn btn-secondary">{fr ? "Structurer ce CV en rubriques" : "Format this CV into sections"}</button>
        <div class="cv-paper"><header id="cv-contact-preview" class="cv-contact-header"></header><h2 id="cv-role-title" class="cv-role-title"></h2><div id="cv-rich-editor"></div></div>
        <textarea id="application-cv" hidden aria-hidden="true" tabindex="-1"></textarea>
        </details>
        <details class="draft-editor"><summary>{fr ? "Ma présentation pour cette candidature" : "My introduction for this application"}</summary><p>{fr ? "Adapte cette présentation au message qui accompagne ta candidature. Garde tes mots et un exemple précis de ton parcours." : "Adapt this introduction to the message accompanying your application. Use your own words and one specific example from your experience."}</p>
        <label for="application-pitch">{fr ? "Pitch de présentation — texte modifiable" : "Introduction pitch — editable text"}</label>
        <textarea id="application-pitch" rows="8" maxlength="4000" autocomplete="off"></textarea>
        </details>
        <label class="application-check"><input id="application-reviewed" type="checkbox" /><span>{fr ? "J’ai relu et vérifié les textes avant export." : "I have reviewed and verified the text before export."}</span></label>
        <div class="application-actions">
          <button type="button" class="btn btn-primary" id="application-print-button" disabled>{fr ? "Imprimer / enregistrer le CV en PDF" : "Print / save CV as PDF"}</button>
          <button type="button" class="btn btn-secondary" id="application-download" disabled>{fr ? "Télécharger CV et pitch (.txt)" : "Download CV and pitch (.txt)"}</button>
        </div>
        </div>
      </section>
      <div class="application-card"><h2 id="application-target-role"></h2><a id="application-apply-link" class="btn btn-primary" target="_blank" rel="noopener noreferrer" hidden>{fr ? "Postuler à cette offre ↗" : "Apply to this opening ↗"}</a><p id="application-apply-note"></p><p>{fr ? "Après l’envoi, indique « Envoyée » dans Mon suivi. Ouvrir l’annonce ne compte pas comme une candidature envoyée." : "After submitting, mark it Sent in My progress. Opening a posting does not count as an application sent."}</p></div>
      <section id="application-print" hidden><div id="application-print-text"></div></section>
    </section>
  </section>
  <noscript>{fr ? "Active JavaScript pour importer ton CV et obtenir un diagnostic." : "Enable JavaScript to import your CV and get an assessment."}</noscript>
  <script>import "../../scripts/application.ts";</script>
  <style is:global>
    #jobs-results { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14px; }
    #jobs-results .application-card { margin: 0; padding: 18px; }
    #jobs-results h3 { font: 700 1.1rem/1.4 var(--font-body); }
    .opportunity-tabs { display: flex; gap: 12px; margin: 12px 0; }
    [data-application-step][aria-current="step"] { background: #e7dfff; }
    #application-evidence details.evidence-card { padding: 14px; margin: 10px 0; border: 1px solid var(--line); border-radius: 8px; }
    .evidence-card > summary { cursor: pointer; font-weight: 700; }
    @media(max-width:650px) { #jobs-results { grid-template-columns:1fr; } }
    .application-page { max-width: 1080px; margin: 0 auto; }
    .application-page .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .application-heading { max-width: 100%; margin-bottom: 28px; }
    .application-heading h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.2; }
    .application-eyebrow { color: var(--accent); font-family: var(--pixel); letter-spacing: .06em; }
    .application-steps { display: grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; padding:0; margin:24px 0; align-items:stretch; }
    .application-steps > button { width:100%; height:100%; min-height:60px; margin:0; padding:12px 8px; display:flex; align-items:center; justify-content:center; text-align:center; box-sizing:border-box; }
    .jobs-search-row { display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px;align-items:end;margin:18px 0; }
    #jobs-location { display:block; width:100%;min-height:56px;box-sizing:border-box;padding:14px 16px;font:inherit;border:2px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink); }
    #jobs-load {min-height:56px;margin:0;}
    .opportunity-tabs {flex-wrap:wrap;}
    .opportunity-tabs > button {margin:0;}
    @media(max-width:650px){ .application-steps {grid-template-columns:repeat(2,minmax(0,1fr));} .jobs-search-row {grid-template-columns:1fr;} .opportunity-tabs {display:grid;grid-template-columns:1fr;} }
    .application-inputs { border: 0; padding: 0; margin: 0; min-width: 0; }
    .application-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
    .application-single-step .application-grid { grid-template-columns: 1fr; }
    .application-card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-m); padding: 24px; margin-bottom: 20px; min-width: 0; }
    .application-card h2 { font-size: 1.5rem; margin-top: 0; }
    .application-card p { line-height: 1.65; }
    .application-page label:not(.application-check) { display: block; font-weight: 600; margin: 16px 0 8px; }
    .application-page textarea { width: 100%; box-sizing: border-box; padding: 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); font: 1rem/1.6 var(--font-body, sans-serif); resize: vertical; }
    .application-page button { min-height: 44px; white-space: normal; }
    .application-page button:disabled { opacity: .55; cursor: not-allowed; }
    .application-actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 16px 0; }
    .application-check { display: flex; align-items: flex-start; gap: 12px; line-height: 1.6; margin: 20px 0; }
    .application-check input { flex: 0 0 auto; width: 20px; height: 20px; margin-top: 3px; }
    .application-note, .application-card > p { color: var(--muted); }
    .application-import { margin-top: 20px; }
    .application-page summary { cursor: pointer; padding: 12px 0; }
    .application-score { color: var(--accent); font-size: 1.5rem; font-weight: 700; }
    .application-evidence article { border-top: 1px solid var(--line); padding: 18px 0; }
    .application-evidence h3 { margin: 14px 0 8px; font: 700 1.25rem/1.4 var(--font-body); }
    .application-evidence blockquote, #application-draft-sources blockquote { border-left: 3px solid var(--accent); margin: 10px 0; padding: 8px 14px; overflow-wrap: anywhere; }
    #application-status { min-height: 1.6em; }
    .application-evidence article { margin: 20px 0; padding: 22px; border: 1px solid var(--line); border-left: 6px solid var(--evidence-color); border-radius: 12px; background: var(--panel); }
    .application-evidence [data-evidence="documented"] { --evidence-color: #237752; --evidence-tint: #e6f5ec; --evidence-ink: #155137; }
    .application-evidence [data-evidence="partial"] { --evidence-color: #a76b14; --evidence-tint: #fff2d6; --evidence-ink: #694007; }
    .application-evidence [data-evidence="not_documented"] { --evidence-color: #466ba6; --evidence-tint: #e8efff; --evidence-ink: #234572; }
    .evidence-badge { display: inline-block; padding: 5px 12px; border-radius: 30px; background: var(--evidence-tint); color: var(--evidence-ink); font: 700 .95rem/1.5 var(--font-body); }
    .application-evidence .evidence-action { padding: 16px; background: var(--evidence-tint); color: var(--evidence-ink); border-radius: 8px; font-weight: 600; }
    .cv-toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 12px; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; }
    .cv-toolbar button, .cv-toolbar input, .cv-toolbar select { font: inherit; padding: 8px 12px; color: var(--ink); background: var(--panel); border: 1px solid var(--line); border-radius: 6px; }
    .cv-toolbar button[aria-pressed="true"] { background: var(--retro-soft-lavender); outline: 2px solid var(--ink); }
    .cv-toolbar button { min-width: 40px; }
    .cv-toolbar [data-command="bold"] { font-weight: 800; }
    .cv-toolbar [data-command="italic"] { font-style: italic; }
    .cv-toolbar [data-command="underline"] { text-decoration: underline; }
    .cv-toolbar [data-command="strike"] { text-decoration: line-through; }
    .cv-toolbar input[type="color"] { width: 44px; height: 44px; padding: 4px; }
    .cv-link-panel > div { padding: 12px; border: 1px solid var(--line); }
    #cv-rich-editor .tiptap { outline: none; min-height: 350px; font: 11pt/1.5 Arial, sans-serif; }
