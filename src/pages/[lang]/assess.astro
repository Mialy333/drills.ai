---
import App from "../../layouts/App.astro";
import { href, LANGS, type Lang } from "../../lib/drills";
import { ASSESSMENT, PILLARS } from "../../lib/assessment";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const questions = ASSESSMENT.map((question) => ({
  ...question,
  pillarLabel: PILLARS[lang][question.pillar],
  prompt: question.prompt[lang],
  options: question.options[lang],
  explanation: question.explanation[lang],
}));
const copy = lang === "fr"
  ? { back: "Retour", eyebrow: "DIAGNOSTIC · PYTHON POUR L'IA", title: "Où en es-tu aujourd'hui ?", intro: "8 questions, environ 5 minutes. Ce premier repère n'est ni un examen ni une certification : il t'aide à choisir quoi travailler ensuite.", progress: "Question", next: "Valider", continue: "Continuer", finish: "Voir mon bilan", correct: "Bonne réponse", review: "À revoir", score: "Bonnes réponses", redo: "Refaire le diagnostic", note: "Tes réponses restent dans ce navigateur. Ce repère initial n'est pas une certification.", resultTitle: "Tu sais maintenant par où commencer", resultIntro: "Ce bilan décrit uniquement tes réponses à ces huit questions. Il ne mesure pas encore une compétence en situation réelle.", demonstrated: "Réponses correctes dans ce diagnostic", reviewLabel: "Notions à consolider", roadmap: "Ton plan de pratique", why: "Pourquoi cette étape", activity: "À faire", success: "Tu sauras que c’est réussi si…", launch: "Commencer mon exercice recommandé", saved: "Exercice prêt dans ce navigateur.", saveFailed: "Le navigateur n’a pas pu enregistrer l’exercice. Autorise le stockage local puis réessaie.", empty: "Aucune réponse correcte cette fois ? Choisis une seule notion et pratique-la d’abord : ton parcours commence ici." }
  : { back: "Back", eyebrow: "DIAGNOSTIC · PYTHON FOR AI", title: "Where are you starting from?", intro: "8 questions, about 5 minutes. This snapshot is not an exam or certification; it helps you choose what to practise next.", progress: "Question", next: "Check answer", continue: "Continue", finish: "See my results", correct: "Correct answer", review: "Review this", score: "Correct answers", redo: "Retake the diagnostic", note: "Your answers stay in this browser. This initial signal is not a certification.", resultTitle: "You know where to start", resultIntro: "This summary reflects only your answers to these eight questions. It does not yet measure performance in a real exercise.", demonstrated: "Correct answers in this diagnostic", reviewLabel: "Concepts to practise", roadmap: "Your practice plan", why: "Why this step", activity: "Try this", success: "You’ll know it worked when…", launch: "Start my recommended exercise", saved: "Your exercise is ready in this browser.", saveFailed: "The browser could not save this exercise. Allow local storage, then try again.", empty: "No correct answers this time? Pick one concept and practise it first: your path starts here." };
---

<App lang={lang} title={copy.title} path="/assess/" section="assess">
  <section class="diagnostic-page" aria-labelledby="diagnostic-title">
    <a class="diagnostic-back" href={href(`/${lang}/`)}>← {copy.back}</a>
    <header class="diagnostic-header">
      <p class="home-kicker">{copy.eyebrow}</p>
      <h1 id="diagnostic-title">{copy.title}</h1>
      <p>{copy.intro}</p>
    </header>

    <div class="diagnostic-card" id="diagnostic">
      <div class="diagnostic-progress-label"><span id="progress-label">{copy.progress} 1 / 8</span><span id="progress-percent">0%</span></div>
      <div class="diagnostic-progress"><span id="progress-fill"></span></div>
      <div id="question-panel"></div>
      <button class="btn btn-primary diagnostic-next" id="next-question" type="button" disabled>{copy.next}</button>
    </div>

    <section id="diagnostic-results" class="diagnostic-results" hidden aria-live="polite"></section>
    <p class="diagnostic-note">{copy.note}</p>
    <script type="application/json" id="assessment-data" set:html={JSON.stringify({ questions, copy, drillHref: href(`/${lang}/python/dynamic-job/`), assessmentHref: href(`/${lang}/assess/`), lang })} />
    <script>
      import { buildAssessmentPlan } from "../../lib/assessment-plan";
      import { readLearnerProfile } from "../../lib/learner";
      type AssessmentQuestion = { id: string; pillar: string; pillarLabel: string; prompt: string; options: string[]; answer: number; explanation: string };
      type PlanStep = { title: string; why: string; activity: string; success: string; action: "exercise" | "diagnostic"; actionLabel: string };
      type AssessmentCopy = { back: string; eyebrow: string; title: string; intro: string; progress: string; next: string; continue: string; finish: string; correct: string; review: string; score: string; redo: string; note: string; resultTitle: string; resultIntro: string; demonstrated: string; reviewLabel: string; roadmap: string; why: string; activity: string; success: string; launch: string; saved: string; saveFailed: string; empty: string };
      const appData = JSON.parse(document.getElementById("assessment-data")?.textContent ?? "{}") as { questions: AssessmentQuestion[]; copy: AssessmentCopy; drillHref: string; assessmentHref: string; lang: "fr" | "en" };
      const { questions, copy, drillHref, assessmentHref, lang } = appData;
      const panel = document.getElementById("question-panel")!;
      const next = document.getElementById("next-question") as HTMLButtonElement;
      const progressLabel = document.getElementById("progress-label")!;
      const progressPercent = document.getElementById("progress-percent")!;
      const progressFill = document.getElementById("progress-fill") as HTMLElement;
      const resultPanel = document.getElementById("diagnostic-results")!;
      const answerByQuestion: number[] = [];
      let current = 0;
      let selected: number | undefined;
      let checked = false;

      function renderQuestion() {
        const q = questions[current];
        selected = undefined;
        checked = false;
        next.disabled = true;
        next.textContent = copy.next;
        progressLabel.textContent = `${copy.progress} ${current + 1} / ${questions.length}`;
        progressPercent.textContent = `${Math.round((current / questions.length) * 100)}%`;
        progressFill.style.width = `${(current / questions.length) * 100}%`;
        const eyebrow = document.createElement("p");
        eyebrow.className = "diagnostic-pillar";
        eyebrow.textContent = q.pillarLabel;
        const prompt = document.createElement("h2");
        prompt.className = "diagnostic-question";
        prompt.textContent = q.prompt;
        const fieldset = document.createElement("fieldset");
        fieldset.className = "diagnostic-options";
        const legend = document.createElement("legend");
        legend.textContent = q.pillarLabel;
        fieldset.append(legend);
        const optionOrder = q.options.map((_, index) => index);
        for (let index = optionOrder.length - 1; index > 0; index -= 1) {
          const swapIndex = Math.floor(Math.random() * (index + 1));
          [optionOrder[index], optionOrder[swapIndex]] = [optionOrder[swapIndex], optionOrder[index]];
        }
        if (optionOrder[0] === q.answer && optionOrder.length > 1) {
          const swapIndex = 1 + Math.floor(Math.random() * (optionOrder.length - 1));
          [optionOrder[0], optionOrder[swapIndex]] = [optionOrder[swapIndex], optionOrder[0]];
        }
        optionOrder.forEach((optionIndex) => {
          const option = q.options[optionIndex];
          const label = document.createElement("label");
          label.className = "diagnostic-option";
          const input = document.createElement("input");
          input.type = "radio";
          input.name = q.id;
          input.value = String(optionIndex);
          input.addEventListener("change", () => {
            selected = optionIndex;
            next.disabled = false;
          });
          const text = document.createElement("span");
          text.textContent = option;
          label.append(input, text);
          fieldset.append(label);
        });
        const feedback = document.createElement("p");
        feedback.className = "diagnostic-feedback";
        feedback.id = "answer-feedback";
        feedback.hidden = true;
        panel.replaceChildren(eyebrow, prompt, fieldset, feedback);
      }

      function showResults() {
        const scores = new Map<string, { correct: number; total: number }>();
        questions.forEach((q, index) => {
          const score = scores.get(q.pillar) ?? { correct: 0, total: 0 };
          score.total += 1;
          if (answerByQuestion[index] === q.answer) score.correct += 1;
          scores.set(q.pillar, score);
        });
        const correct = questions.filter((q, index) => answerByQuestion[index] === q.answer).length;
        const date = new Date().toISOString();
        const plan = buildAssessmentPlan(answerByQuestion, lang, readLearnerProfile());
        let stored = false;
        try {
          localStorage.setItem("drills.assessment.v1", JSON.stringify({ version: 1, date, correct, answers: answerByQuestion, pillars: Object.fromEntries(scores), focusQuestionId: plan.focusId }));
          localStorage.setItem(`DRILLS_DYNAMIC_JOB_DATA_${lang.toUpperCase()}`, JSON.stringify(plan.drill));
          stored = true;
        } catch {}

        const heading = document.createElement("h2");
        heading.textContent = copy.resultTitle;
        const intro = document.createElement("p");
        intro.className = "diagnostic-result-lead";
        intro.textContent = copy.resultIntro;
        const score = document.createElement("p");
        score.className = "diagnostic-score-summary";
        score.textContent = `${copy.score}: ${correct} / ${questions.length}`;
        const observations = document.createElement("div");
        observations.className = "diagnostic-observations";
        const observed = document.createElement("section");
        const observedTitle = document.createElement("h3");
        observedTitle.textContent = copy.demonstrated;
        const observedList = document.createElement("ul");
        plan.correctIds.forEach((id) => {
          const q = questions.find((item) => item.id === id);
          if (!q) return;
          const item = document.createElement("li");
          item.textContent = `${q.pillarLabel} · ${q.prompt}`;
          observedList.append(item);
        });
        if (!observedList.childElementCount) {
          const item = document.createElement("li");
          item.textContent = copy.empty;
          observedList.append(item);
        }
        observed.append(observedTitle, observedList);
        const toReview = document.createElement("section");
        const reviewTitle = document.createElement("h3");
        reviewTitle.textContent = copy.reviewLabel;
        const reviewList = document.createElement("ul");
        plan.reviewIds.forEach((id) => {
          const q = questions.find((item) => item.id === id);
          if (!q) return;
          const item = document.createElement("li");
          item.textContent = `${q.pillarLabel} · ${q.prompt}`;
          reviewList.append(item);
        });
        if (!reviewList.childElementCount) {
          const item = document.createElement("li");
          item.textContent = lang === "fr" ? "Aucune notion à reprendre sur ces huit questions." : "No concepts to review in these eight questions.";
          reviewList.append(item);
        }
        toReview.append(reviewTitle, reviewList);
        observations.append(observed, toReview);

        const roadmapTitle = document.createElement("h3");
        roadmapTitle.className = "diagnostic-roadmap-title";
        roadmapTitle.textContent = copy.roadmap;
        const scheduleNote = document.createElement("p");
        scheduleNote.className = "diagnostic-schedule-note";
        scheduleNote.textContent = plan.scheduleNote ?? "";
        scheduleNote.hidden = !plan.scheduleNote;
        const roadmap = document.createElement("ol");
        roadmap.className = "diagnostic-roadmap";
        plan.steps.forEach((step: PlanStep, index: number) => {
          const item = document.createElement("li");
          const stepTitle = document.createElement("h4");
          stepTitle.textContent = step.title;
          const why = document.createElement("p");
          const whyLabel = document.createElement("strong");
          whyLabel.textContent = `${copy.why}: `;
          why.append(whyLabel, document.createTextNode(step.why));
          const activity = document.createElement("p");
          const activityLabel = document.createElement("strong");
          activityLabel.textContent = `${copy.activity}: `;
          activity.append(activityLabel, document.createTextNode(step.activity));
          const success = document.createElement("p");
          const successLabel = document.createElement("strong");
          successLabel.textContent = `${copy.success} `;
          success.append(successLabel, document.createTextNode(step.success));
          const action = document.createElement("a");
          action.className = index === 0 ? "diagnostic-step-action is-primary" : "diagnostic-step-action";
          action.href = step.action === "exercise" ? drillHref : assessmentHref;
          action.textContent = step.actionLabel;
          item.dataset.step = String(index + 1);
          item.append(stepTitle, why, activity, success, action);
          roadmap.append(item);
        });
        const actions = document.createElement("div");
        actions.className = "diagnostic-actions";
        const drillLink = document.createElement("a");
        drillLink.className = "btn btn-primary diagnostic-launch";
        drillLink.href = drillHref;
        drillLink.textContent = copy.launch;
        drillLink.setAttribute("aria-disabled", String(!stored));
        const redo = document.createElement("button");
        redo.className = "btn";
        redo.type = "button";
        redo.textContent = copy.redo;
        redo.addEventListener("click", () => window.location.reload());
        const status = document.createElement("p");
        status.className = stored ? "diagnostic-save-status" : "diagnostic-save-status is-error";
        status.setAttribute("role", stored ? "status" : "alert");
        status.textContent = stored ? copy.saved : copy.saveFailed;
        drillLink.addEventListener("click", (event) => {
          if (stored) return;
          event.preventDefault();
          try {
            localStorage.setItem(`DRILLS_DYNAMIC_JOB_DATA_${lang.toUpperCase()}`, JSON.stringify(plan.drill));
            stored = true;
            drillLink.setAttribute("aria-disabled", "false");
            status.className = "diagnostic-save-status";
            status.setAttribute("role", "status");
            status.textContent = copy.saved;
            window.location.assign(drillHref);
          } catch {
            status.textContent = copy.saveFailed;
          }
        });
        roadmap.querySelectorAll<HTMLAnchorElement>(".diagnostic-step-action").forEach((action) => {
          if (action.href !== new URL(drillHref, window.location.href).href) return;
          action.addEventListener("click", (event) => {
            if (!stored) {
              event.preventDefault();
              drillLink.click();
            }
          });
        });
        actions.append(drillLink, redo);
        resultPanel.replaceChildren(heading, intro, score, observations, roadmapTitle, scheduleNote, roadmap, status, actions);
        resultPanel.hidden = false;
        document.getElementById("diagnostic")!.hidden = true;
      }

      next.addEventListener("click", () => {
        const q = questions[current];
        if (!checked) {
          if (selected === undefined) return;
          answerByQuestion[current] = selected;
          checked = true;
          const feedback = document.getElementById("answer-feedback")!;
          feedback.textContent = `${selected === q.answer ? copy.correct : copy.review}. ${q.explanation}`;
          feedback.hidden = false;
          next.textContent = current === questions.length - 1 ? copy.finish : copy.continue;
          panel.querySelectorAll<HTMLInputElement>("input[type=radio]").forEach((input) => { input.disabled = true; });
          progressPercent.textContent = `${Math.round(((current + 1) / questions.length) * 100)}%`;
          progressFill.style.width = `${((current + 1) / questions.length) * 100}%`;
          return;
        }
        if (current === questions.length - 1) {
          showResults();
          return;
        }
        current += 1;
        renderQuestion();
      });

      renderQuestion();
    </script>
    <style>
      .diagnostic-page { max-width: 820px; margin: 0 auto; }
      .diagnostic-back { display: inline-block; margin-bottom: 22px; text-decoration: none; }
      .diagnostic-header { margin-bottom: 24px; }
      .diagnostic-header > p:last-child, .diagnostic-note { color: var(--muted); }
      :global(.diagnostic-result-lead), :global(.diagnostic-schedule-note) { color: var(--muted); }
      .diagnostic-card, .diagnostic-results { padding: clamp(18px, 4vw, 32px); border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--panel); box-shadow: var(--shadow-card); }
      .diagnostic-progress-label { display: flex; justify-content: space-between; color: var(--muted); font-size: .9rem; }
      .diagnostic-progress, .diagnostic-skill-meter { display: block; height: 8px; overflow: hidden; border-radius: 8px; background: var(--line); }
      .diagnostic-progress { margin: 8px 0 26px; }
      .diagnostic-progress span, .diagnostic-skill-meter span { display: block; height: 100%; background: var(--ok); transition: width .2s ease; }
      :global(.diagnostic-pillar) { color: var(--link); font-size: .9rem; font-weight: 700; }
      :global(.diagnostic-question) { margin: 8px 0 20px; font-size: 1.3rem; }
      :global(.diagnostic-options) { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; margin: 0; padding: 0; border: 0; }
      :global(.diagnostic-options legend) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
      :global(.diagnostic-option) { display: flex; gap: 10px; align-items: flex-start; padding: 12px; border: 1px solid var(--line); border-radius: var(--radius-s); background: var(--panel); cursor: pointer; }
      :global(.diagnostic-option:has(input:checked)) { border-color: var(--accent); }
      :global(.diagnostic-option input) { flex: 0 0 auto; margin: 5px 0 0; accent-color: var(--accent); }
      :global(.diagnostic-option span) { min-width: 0; }
      :global(.diagnostic-feedback) { padding: 12px; border-left: 3px solid var(--ok); background: var(--panel); }
      .diagnostic-next { width: 100%; margin-top: 16px; }
      .diagnostic-next:disabled { opacity: .5; cursor: not-allowed; }
      .diagnostic-note { margin-top: 14px; font-size: .9rem; }
      :global(.diagnostic-skill-list) { display: grid; gap: 14px; margin: 20px 0; padding: 0; list-style: none; }
      :global(.diagnostic-skill-list li) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 12px; }
      :global(.diagnostic-skill-meter) { display: block; grid-column: 1 / -1; height: 8px; overflow: hidden; border-radius: 8px; background: var(--line); }
      :global(.diagnostic-skill-meter span) { display: block; height: 100%; background: var(--ok); transition: width .2s ease; }
      :global(.diagnostic-actions) { display: flex; flex-wrap: wrap; gap: 10px; }
      :global(.diagnostic-save-status) { margin: 0; color: var(--ok); }
      :global(.diagnostic-save-status.is-error) { color: var(--warn); }
      :global(.diagnostic-launch[aria-disabled="true"]) { opacity: .7; }
      :global(.diagnostic-step-action) { display: inline-flex; align-items: center; min-height: 44px; margin-top: 10px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; color: var(--link); font-weight: 700; text-decoration: none; }
      :global(.diagnostic-step-action:hover) { background: var(--raise); }
      :global(.diagnostic-step-action.is-primary) { border-color: var(--accent); background: var(--accent); color: var(--accent-ink); }
      @media (min-width: 720px) { :global(.diagnostic-observations) { grid-template-columns: 1fr 1fr; } }
    </style>
  </section>
</App>
