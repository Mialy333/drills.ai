---
// Old URLs (/fr/drills/d1/) from the first version: send them to the Python track.
import { drills, href, LANGS, type Lang } from "../../../lib/drills";

export function getStaticPaths() { return []; }
function archivedStaticPaths() {
  return import.meta.env.DEV
    ? LANGS.flatMap((lang) => drills("python", lang).map((d) => ({ params: { lang, id: d.id } })))
    : [];
}
const lang = Astro.params.lang as Lang;
const target = href(`/${lang}/python/${Astro.params.id}/`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Drills</title>
  </head>
  <body><a href={target}>{target}</a></body>
</html>
