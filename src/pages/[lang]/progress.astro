---
import App from "../../layouts/App.astro";
import { href, LANGS, type Lang } from "../../lib/drills";
export function getStaticPaths() { return LANGS.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const fr = lang === "fr";
---
<App lang={lang} title={fr ? "Mon suivi" : "My progress"} path="/progress/" section="progress">
  <section class="block">
    <h1>{fr ? "Où en est ta candidature ?" : "Where does your application stand?"}</h1>
    <p>{fr ? "Trois étapes concrètes. Aucun niveau, point ou classement." : "Three concrete steps. No levels, points or ranking."}</p>
    <ol class="application-milestones">
      {[fr ? "Profil prêt" : "Profile ready", fr ? "Offre analysée" : "Posting analysed", fr ? "Candidature relue" : "Application reviewed"].map((title,index) => <li><strong>{title}</strong><span data-step={index}>{fr ? "À faire" : "To do"}</span></li>)}
    </ol>
    <p id="application-progress-note" role="status"></p>
    <a class="btn btn-primary" href={href(`/${lang}/apply/`)}>{fr ? "Ouvrir mon dossier" : "Open my application"}</a>
    <a class="btn btn-secondary" href={href(`/${lang}/prepare/`)}>{fr ? "Préparer mon entretien" : "Prepare for my interview"}</a>
    <p>{fr ? "Le suivi concerne le dernier dossier dans ce navigateur. « Relue » signifie que tu as confirmé la relecture, pas que la candidature a été envoyée ou acceptée." : "Progress refers to the latest application in this browser. Reviewed means you confirmed your review, not that the application was sent or accepted."}</p>
  </section>
  <script>
    import { readApplicationState, applicationSteps } from "../../lib/application-state";
    let state = null;
    try { state = readApplicationState(sessionStorage, localStorage); } catch {}
    const fr = document.documentElement.lang === "fr";
    const steps = applicationSteps(state);
    document.querySelectorAll<HTMLElement>("[data-step]").forEach((node, index) => { node.textContent = steps[index] ? (fr ? "Fait" : "Done") : (fr ? "À faire" : "To do"); });
    const note = document.getElementById("application-progress-note");
    if (note) note.textContent = state?.result?.role_title ?? (fr ? "Commence par importer ton CV ou compléter ton profil." : "Start by importing your CV or completing your profile.");
  </script>
  <style>.application-milestones { list-style: none; padding: 0; display: grid; gap: 16px; margin: 28px 0; }.application-milestones li { display: flex; justify-content: space-between; gap: 20px; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius-m); background: var(--panel); }</style>
</App>
